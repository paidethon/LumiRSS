FRESHRSS_BASE_URL=http://127.0.0.1:8080
FRESHRSS_USERNAME=admin
FRESHRSS_API_PASSWORD=

# 0013 Gate 4：FreshRSS Web UI 高级逃生入口（可选）。
# 只有当浏览器可以从外部安全访问的 public URL 才配置（绝不能填
# http://freshrss:80 之类 Docker 内部主机名，也不能带凭据）；
# 留空 = 设置中心不渲染该链接（诚实降级，不出假入口）。
FRESHRSS_PUBLIC_URL=

# 0014：RSSHub 实例（服务端配置，浏览器绝不直连 RSSHub）。
# RSSHUB_BASE_URL：BFF 自身预览抓取可达的地址（宿主机视角，如
# http://127.0.0.1:1200；也可以是公网实例 https://rsshub.app）。
# RSSHUB_FRESHRSS_BASE_URL（可选）：FreshRSS 容器视角可达的地址
# （Docker 网络内如 http://rsshub:1200）——订阅后的抓取由 FreshRSS
# 执行。留空 = 与 RSSHUB_BASE_URL 相同。两者都留空 = RSSHub 发现禁用
# （/api/v1/rsshub/preview 返回 503 rsshub_not_configured）。
RSSHUB_BASE_URL=
RSSHUB_FRESHRSS_BASE_URL=
