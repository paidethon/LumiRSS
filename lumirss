  else
    warn "stack is not running — './lumirss deploy' to start."
  fi
}

cmd_logs() {
  require_env_file
  DC_D logs "$@"
}

# ---------------------------------------------------------------------------
# Backup/restore container image: LUMIRSS_BACKUP_IMAGE override wins; the
# default is the stack's own BFF image (resolved from compose config — python3
# is part of the BFF runtime, so a backup/restore needs NO extra pull, also on
# air-gapped hosts). An override image must provide python3 + tar; when it
# cannot do the job the backup fails loudly instead of producing an
# inconsistent package (live databases are never bare-tarred, FIX-192).
backup_image() { # prints the image reference for backup/restore containers
  if [[ -n "${LUMIRSS_BACKUP_IMAGE:-}" ]]; then printf '%s\n' "$LUMIRSS_BACKUP_IMAGE"; return; fi
  local img
  img="$(DC_D config --format json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("services",{}).get("bff",{}).get("image",""))' 2>/dev/null || true)"
  printf '%s\n' "${img:-ghcr.io/paidethon/lumirss/lumirss-bff:${IMAGE_TAG:-latest}}"
}

# 快照程序（FIX-192 一致性备份的趟 1；经 stdin 喂给备份容器里的 python3，
# 不落盘、不进 argv）。/src/lumi-data 与 /src/freshrss-data 只读挂载，
# /dst 为备份目录；对每个 SQLite 库用 online backup API 写出同一 WAL 读点
# 的快照（并发写入只会让快照更早，绝不撕裂），并生成 MANIFEST.txt。
# mode=ro：卷严格只读；WAL 只读访问依赖已存在的 -shm（任何活跃写入者都会
# 提供；干净停止的栈已 checkpoint，普通只读打开即可）。必要时可用
# LUMIRSS_SNAPSHOT_SRC / LUMIRSS_SNAPSHOT_DST 覆盖挂载点（测试用）。
LUMIRSS_SNAPSHOT_PROGRAM='
import datetime, hashlib, os, shutil, sqlite3, tempfile
from pathlib import Path

SRC_ROOTS = [Path(p) for p in os.environ.get(
    "LUMIRSS_SNAPSHOT_SRC", "/src/lumi-data:/src/freshrss-data").split(":") if p]
DST = Path(os.environ.get("LUMIRSS_SNAPSHOT_DST", "/dst"))
TREE_BY_NAME = {"lumi-data": "lumi-sqlite", "freshrss-data": "freshrss-sqlite"}
DB_SUFFIXES = (".sqlite", ".sqlite3", ".db")
SIDECAR_SUFFIXES = ("", "-wal", "-shm", "-journal")

def sha256_of(path):
    digest = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()

def snapshot_db(db, out):
    """Consistent snapshot of one live SQLite database.

    Path 1 (normal): read-only online backup — every page comes from ONE WAL
    read point, consistent under concurrent writers (they keep -shm alive).

    Path 2 (fallback): an orphaned -wal/-shm (writer killed uncleanly, no live
    -shm) cannot be recovered through a read-only mount, so db + sidecars are
    copied to container-writable tmp and recovered THERE. Reached only when
    path 1 failed, i.e. no live writer held the database; the volume itself is
    never written. integrity_check proves the recovered snapshot is sane — a
    torn trio fails loudly instead of producing a bad backup.
    """
    out.parent.mkdir(parents=True, exist_ok=True)
    try:
        source = sqlite3.connect(db.as_uri() + "?mode=ro", uri=True, timeout=30.0)
        target = sqlite3.connect(str(out))
        try:
            source.backup(target)
            return
        finally:
            source.close()
            target.close()
    except sqlite3.OperationalError:
        pass
    tmp = Path(tempfile.mkdtemp(prefix="lumirss-snapshot-"))
    try:
        for suffix in SIDECAR_SUFFIXES:
            side = Path(str(db) + suffix)
            if side.exists():
                shutil.copyfile(side, tmp / (db.name + suffix))
        recovered = sqlite3.connect(str(tmp / db.name), timeout=30.0)
        target = sqlite3.connect(str(out))
        try:
            recovered.backup(target)
        finally:
            recovered.close()
            target.close()
        check = sqlite3.connect(str(out))
        try:
            verdict = check.execute("PRAGMA integrity_check").fetchone()[0]
        finally:
            check.close()
        if verdict != "ok":
            raise sqlite3.DatabaseError(
                "recovered snapshot of %s failed integrity_check: %s" % (db, verdict))
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

rows = []
for src in SRC_ROOTS:
    if not src.is_dir():
        continue
    tree = TREE_BY_NAME.get(src.name, src.name + "-sqlite")
    for root, dirs, files in os.walk(src):
        dirs.sort()
        for name in sorted(files):
            db = Path(root) / name
            if db.suffix not in DB_SUFFIXES:
                continue
            out = DST / tree / db.relative_to(src)
            snapshot_db(db, out)
            rows.append((str(out.relative_to(DST)), out.stat().st_size, sha256_of(out)))

manifest = [
    "# LumiRSS backup manifest (FIX-192)",
    "# cli_version: " + os.environ.get("LUMIRSS_CLI_VERSION", "unknown"),
    "# created_utc: " + datetime.datetime.now(datetime.timezone.utc).replace(
        microsecond=0).isoformat().replace("+00:00", "Z"),
    "# consistency: each database below is an SQLite online-backup snapshot",
    "#   (single WAL read point; consistent under concurrent writers). Every",
    "#   other file in the *.files.tar.gz archives is a file-level copy;",
    "#   writers of those files: the bff container (incl. its scheduler) and",
    "#   the freshrss php container (cron auto-refresh).",
    "# restore: untar the *.files.tar.gz archives into the volume, overlay the",
    "#   lumi-sqlite/ + freshrss-sqlite/ trees preserving relative paths,",
    "#   verify the sha256 lines below, then let the BFF re-apply its",
    "#   migrations on start.",
    "#",
    "# <sha256>  <size>  <path-relative-to-backup-dir>",
]
for path, size, digest in rows:
    manifest.append("%s  %d  %s" % (digest, size, path))
(DST / "MANIFEST.txt").write_text("\n".join(manifest) + "\n", encoding="utf-8")
print("snapshot: %d SQLite database(s) via online backup API" % len(rows))
'

# ---------------------------------------------------------------------------
# Backup layout (FIX-192, FIX-209) — everything of one backup lives in one
# per-stamp directory:
#
#   $BACKUP_DIR/<stamp>/
#     MANIFEST.txt                  sha256 + size of every snapshot DB + CLI version
#     lumi-sqlite/…                 online-backup snapshots, paths relative to the
#                                   lumi-data root (lumi.sqlite, users/<uid>/lumi.sqlite)
#     freshrss-sqlite/…             same for freshrss-data (FreshRSS db.sqlite)
#     lumi-data.files.tar.gz        file-level tar, *.sqlite + -wal/-shm/-journal excluded
#     freshrss-data.files.tar.gz    same
#     config.tar.gz                 $ENV_FILE + docker-compose.prod.yml
#   $BACKUP_DIR/LATEST              basename of the stamp dir, written atomically
#                                   (tmp + mv) and only after FULL success
#
# 一致性边界（FIX-192，诚实声明）：
# - 数据库（控制库 lumi.sqlite、每用户 users/<uid>/lumi.sqlite、FreshRSS
#   db.sqlite）：SQLite online backup API 快照——所有页来自同一个 WAL 读点，
#   并发写入只会让快照落在更早的一致状态，绝不会出现裸 tar 活库（WAL 模式
#   下主文件与 -wal 不一致）的缺页/撕裂。快照在备份镜像内只读执行；WAL 只
#   读访问依赖已存在的 -shm（任何活跃写入者都会提供；干净停止的栈已把 WAL
#   checkpoint 掉，普通只读打开即可）。
# - 其余文件（control-secrets.json、users/<uid>/secrets.json、FreshRSS
#   config.php 等）：file-level tar 拷贝；写入者 = bff 容器（含其内置调度
#   器）与 freshrss php 容器（cron 自动刷新）。这类文件低频写且本身容错。
# 恢复：cmd_restore 解 files.tar 后把 <stamp>/lumi-sqlite/ 与
# freshrss-sqlite/ 按相对路径覆盖回卷，先校验 MANIFEST.txt 的 sha256；
# tests/deploy/run-deploy-tests.sh 有并发写一致性 + 隔离应用恢复测试。
cmd_backup() {
  require_env_file
  local proj stamp dir config_json vol
  config_json="$(DC_D config --format json 2>/dev/null || true)"
  proj="$(printf '%s' "$config_json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("name","lumirss-prod"))' 2>/dev/null || echo lumirss-prod)"
  stamp="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$BACKUP_DIR"
  # FIX-209: 秒级时间戳会撞名（连发/并发触发互相覆盖）。不带 -p 的 mkdir
  # 是原子的：撞名就退到带 PID 的唯一目录，任何既有备份都不被改动。
  dir="$BACKUP_DIR/$stamp"
  if ! mkdir "$dir" 2>/dev/null; then
    dir="$BACKUP_DIR/$stamp-$$"
    mkdir "$dir"
  fi
  log "backing up volumes of project '$proj' to $dir"
  # FIX-192: 备份镜像默认 = 正在运行的 BFF 镜像（backup_image 解析；
  # python3 是 BFF 运行时的一部分，离线主机无需额外拉取任何镜像）。
  # LUMIRSS_BACKUP_IMAGE 仍可整体覆盖；覆盖镜像必须提供 python3——缺失时
  # 快照趟失败并如实报错，绝不退回产出不一致备份的裸 tar。
  BACKUP_IMAGE="$(backup_image)"
  # 趟 1（一致性关键路径）：对两个卷里的每个 SQLite 数据库做 online backup
  # API 快照。镜像的默认入口/命令无关紧要：--entrypoint 显式指定 python3，
  # 程序经 stdin 传入（不落盘、不进 argv 日志）。
  if ! printf '%s' "$LUMIRSS_SNAPSHOT_PROGRAM" | docker_cmd run --rm -i \
        -v "${proj}_lumi-data:/src/lumi-data:ro" \
        -v "${proj}_freshrss-data:/src/freshrss-data:ro" \
        -v "$dir:/dst" \
        -e LUMIRSS_CLI_VERSION="$LUMIRSS_CLI_VERSION" \
        --entrypoint python3 "$BACKUP_IMAGE" -; then
    err "SQLite snapshot pass failed (backup image '$BACKUP_IMAGE' must provide python3; live databases are never bare-tarred)"
    rm -rf "$dir"
    return 1
  fi
  # 趟 2：非数据库文件 file-level tar；*.sqlite 与 -wal/-shm/-journal 边车
  # 一律排除（它们由趟 1 的一致性快照覆盖，混入裸拷贝会重新引入不一致）。
  for vol in lumi-data freshrss-data; do
    if ! docker_cmd run --rm -v "${proj}_${vol}:/src:ro" -v "$dir":/dst "$BACKUP_IMAGE" \
        tar czf "/dst/${vol}.files.tar.gz" \
          --exclude='*.sqlite' --exclude='*.sqlite3' --exclude='*.db' \
          --exclude='*.sqlite-wal' --exclude='*.sqlite-shm' --exclude='*.sqlite-journal' \
          -C /src .; then
      err "backup of $vol failed"
      rm -rf "$dir"
      return 1
    fi
  done
  if ! tar czf "$dir/config.tar.gz" -C . "$ENV_FILE" docker-compose.prod.yml; then
    err "backup of config failed"
    rm -rf "$dir"
    return 1
  fi
  # FIX-209: LATEST 只在整包成功后原子写入（临时文件 + mv）；任何失败都
  # 让既有 LATEST 与既有备份原封不动（失败目录已整目录删除）。
  printf '%s\n' "$(basename "$dir")" > "$BACKUP_DIR/.LATEST.$$"
  mv -f "$BACKUP_DIR/.LATEST.$$" "$BACKUP_DIR/LATEST"
  log "backup done: $dir (SQLite online-backup snapshots + file tars + MANIFEST.txt + config.tar.gz)"
}

cmd_restore() {
  require_env_file
  local target="${1:-}"; shift || true
  if [[ -z "$target" ]]; then { err "usage: ./lumirss restore <backup.tar.gz> [--yes]"; exit 1; }; fi
  local yes=""; [[ "${1:-}" == "--yes" ]] && yes=1
  if [[ -z "$yes" && -t 0 ]]; then
    read -r -p "DESTRUCTIVE: restore from $target and OVERWRITE current data? Type RESTORE to continue: " ans
    [[ "$ans" == "RESTORE" ]] || { log "aborted."; return 0; }
  elif [[ -z "$yes" ]]; then
    err "refusing destructive restore without --yes (or an interactive terminal)."; exit 1
  fi
  local vol="lumi-data"
  if [[ "$target" == *freshrss-data* ]]; then vol="freshrss-data"; fi
  local proj
  proj="$(DC_D config --format json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("name","lumirss-prod"))' 2>/dev/null || echo lumirss-prod)"
  log "stopping bff…"; DC_D stop bff >/dev/null 2>&1 || true
  local bdir
  bdir="$(cd "$(dirname "$target")" && pwd)"
  log "restoring $vol from $target"
  # 与备份同一镜像来源（backup_image：覆盖 > BFF 镜像 > GHCR 回退）——
  # 离线主机恢复时不再依赖额外拉取 alpine。
  BACKUP_IMAGE="$(backup_image)"
  docker_cmd run --rm -v "${proj}_${vol}:/dst" -v "$bdir":/bkp:ro "$BACKUP_IMAGE" \
    sh -c "rm -rf /dst/..?* /dst/.[!.]* /dst/* 2>/dev/null; tar xzf /bkp/$(basename "$target") -C /dst"
  # FIX-192: 新格式备份把一致性 SQLite 快照放在 lumi-sqlite/ 或
  # freshrss-sqlite/（见 cmd_backup）。存在则先整目录校验 MANIFEST.txt 的
  # sha256，再把快照按相对路径覆盖回卷。旧格式备份（整卷 tar、无快照树）
  # 没有该目录，保持历史行为不变。
  local tree="lumi-sqlite"
  [[ "$vol" == "freshrss-data" ]] && tree="freshrss-sqlite"
  if [[ -d "$bdir/$tree" ]]; then
    log "overlaying consistent SQLite snapshots ($tree) and verifying MANIFEST.txt checksums"
    docker_cmd run --rm -v "${proj}_${vol}:/dst" -v "$bdir":/bkp:ro "$BACKUP_IMAGE" \
      sh -c "cp -a /bkp/$tree/. /dst/ && cd /bkp && awk 'NF && \$1 !~ /^#/ {print \$1 \"  \" \$3}' MANIFEST.txt | sha256sum -c - >/dev/null" \
      || { err "MANIFEST checksum mismatch — refusing an inconsistent restore."; DC_D start bff >/dev/null 2>&1 || true; exit 1; }
  fi
  DC_D start bff >/dev/null 2>&1 || true
  wait_health 180 && log "restore complete."
}

cmd_doctor() {
  local fail=0
  check() { # check PASS|WARN|FAIL description…
    local level="$1"; shift
    case "$level" in
      PASS) log "PASS  $*";;
      WARN) warn "WARN  $*";;
      FAIL) err   "FAIL  $*"; fail=1;;
    esac
  }
  command -v docker >/dev/null && check PASS "docker installed" || check FAIL "docker missing"
  docker_cmd compose version >/dev/null 2>&1 && check PASS "compose plugin" || check FAIL "compose plugin missing"
  if [[ -f "$ENV_FILE" ]]; then
    check PASS "$ENV_FILE present"
  else
    check WARN "$ENV_FILE missing (run deploy)"
  fi
  local domain; domain="$(env_value DOMAIN)"
  if [[ -n "$domain" && "$domain" != localhost ]]; then
    getent hosts "$domain" >/dev/null 2>&1 && check PASS "DNS $domain" || check WARN "DNS $domain not resolving"
  fi
  if docker_cmd info >/dev/null 2>&1; then
    if [[ -f "$ENV_FILE" ]]; then
      local running
      running="$(DC_D ps --status running 2>/dev/null | tail -n +2 | wc -l)"
      [[ "$running" -eq 4 ]] && check PASS "4/4 containers running" || check WARN "only $running/4 containers running"
      DC_D exec bff python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=5).status==200 else 1)" >/dev/null 2>&1 \
        && check PASS "bff health/ready" || check WARN "bff health/ready not OK"
      for svc in lumirss-freshrss lumirss-rsshub; do
        state="$(docker_cmd inspect --format '{{.State.Health.Status}}' "$svc" 2>/dev/null || echo missing)"
        if [[ "$state" == "healthy" ]]; then
          check PASS "$svc healthy"
        else
          check WARN "$svc health: $state"
        fi
      done
      # Resource-budget guard: a killed container means the limit is too
      # low for real traffic, never a successful "lower number".
      for svc in lumirss-web lumirss-bff lumirss-freshrss lumirss-rsshub; do
        oom="$(docker_cmd inspect --format '{{.State.OOMKilled}}' "$svc" 2>/dev/null || echo missing)"
        if [[ "$oom" == "true" ]]; then
          check FAIL "$svc was OOMKilled — raise its LUMIRSS_*_MEM_LIMIT"
        elif [[ "$oom" == "false" ]]; then
          check PASS "$svc not OOMKilled"
        fi
        restarts="$(docker_cmd inspect --format '{{.RestartCount}}' "$svc" 2>/dev/null || echo 0)"
        if [[ "$restarts" =~ ^[0-9]+$ ]] && ((restarts > 0)); then
          check WARN "$svc restarted ${restarts}x (see './lumirss logs')"
        fi
      done
      if [[ "$(env_value LUMIRSS_AUTH_MODE)" == "session" ]]; then
        initialized="$(DC_D exec bff python -c "import sqlite3
try:
    c = sqlite3.connect('/data/lumi.sqlite')
    n = c.execute('SELECT COUNT(*) FROM auth_password').fetchone()[0]
except Exception:
    n = 0
print(n)" 2>/dev/null || echo 0)"
        if [[ "$initialized" == "1" ]]; then
          check PASS "session password initialized"
        else
          check WARN "session auth on but no password — run './lumirss set-password'"
        fi
      fi
      local token; token="$(env_value LUMIRSS_INTERNAL_TOKEN)"
      if DC_D exec -e LT="$token" bff python -c "import urllib.request,json,os; req=urllib.request.Request('http://127.0.0.1:8000/api/v1/backups/capabilities', headers={'X-Lumi-Token': os.environ.get('LT','')}); print(json.load(urllib.request.urlopen(req, timeout=10)).get('fullBackupReady'))" 2>/dev/null | grep -q True; then
        check PASS "backup readiness (fullBackupReady)"
      else
        check WARN "fullBackupReady not OK (see /api/v1/backups/capabilities)"
      fi
      if ((EXTERNAL_MODE == 1)); then
        local pub
        pub="$(docker_cmd ps --format '{{.Names}} {{.Ports}}' 2>/dev/null | grep '^lumirss-web ' || true)"
        if echo "$pub" | grep -E '(0\.0\.0\.0|\[::\]):(80|443)->' >/dev/null; then
          check FAIL "web publishes public 80/443 in external-caddy mode"
        else
          check PASS "web not published on public 80/443"
        fi
        if command -v ss >/dev/null && ss -lnt 2>/dev/null | awk '{print $4}' | grep -qE "(127\.0\.0\.1|\[::1\]):${UPSTREAM_PORT}$"; then
          check PASS "upstream loopback-only (127.0.0.1:${UPSTREAM_PORT})"
        else
          check WARN "upstream 127.0.0.1:${UPSTREAM_PORT} not listening"
        fi
      fi
    fi
  else
    check WARN "no docker daemon access"
  fi
  if ((EXTERNAL_MODE == 1)) && [[ -n "${domain:-}" && "$domain" != localhost ]]; then
    if curl -fsS -o /dev/null --max-time 10 "https://$domain/" 2>/dev/null; then
      check PASS "public HTTPS https://$domain/"
    else
      check WARN "public HTTPS https://$domain/ not reachable"
    fi
  fi
  local avail; avail="$(df -P . | awk 'NR==2{print $4}')"
  [[ "$avail" -ge 2097152 ]] && check PASS "disk >= 2 GiB" || check WARN "disk < 2 GiB"
  [[ -w "$BACKUP_DIR" || -w . ]] && check PASS "backup dir writable" || check WARN "backup dir not writable"
  [[ $fail -eq 0 ]] && log "doctor: no failures." || { err "doctor found failures."; exit 1; }
}

cmd_rollback() {
  require_env_file
  local prev_tag prev_env
  prev_tag="$(cat "$BACKUP_DIR/.image-tag.previous" 2>/dev/null || echo latest)"
  prev_env="$BACKUP_DIR/.env.prod.previous"
  if [[ -f "$prev_env" ]]; then cp -f "$prev_env" "$ENV_FILE"; fi
  log "rolling back to image tag: $prev_tag (config restored from previous snapshot)"
  LUMIRSS_IMAGE_TAG="$prev_tag" DC_D up -d --remove-orphans
  wait_health 180 && log "rollback complete (tag: $prev_tag)." || { err "rollback health check failed."; exit 1; }
}

cmd_caddy_config() { # print the managed host-Caddy site block
  require_env_file
  local domain; domain="$(env_value DOMAIN)"
  if [[ -z "$domain" || "$domain" == "localhost" || "$domain" == "127.0.0.1" ]]; then
    err "DOMAIN in $ENV_FILE must be a real FQDN to render the host-Caddy site block."
    exit 1
  fi
  # Optional static project dashboard at /project/ — only emitted when the
  # operator placed the generated board (tools/progress-dashboard/dist) at
  # LUMIRSS_PROJECT_DIR (default: <repo>/project-dashboard). Read-only
  # file_server; never proxies, never lists directories.
  local project_root="${LUMIRSS_PROJECT_DIR:-$(pwd)/project-dashboard}"
  local project_block=""
  if [[ -f "$project_root/index.html" ]]; then
    project_block="$(cat <<PB
	handle_path /project/* {
		root * $project_root
		file_server
	}
PB
)"
  fi
  local body=""
  [[ -n "$project_block" ]] && body="$project_block"$'\n'
  cat <<EOF
# BEGIN LUMIRSS — generated by './lumirss caddy-config'; managed block.
# Anything between the BEGIN/END markers is replaced on regeneration.
${domain} {
${body}	reverse_proxy 127.0.0.1:${UPSTREAM_PORT}
}
# END LUMIRSS
EOF
}

cmd_set_password() { # install/rotate the session-login password (hash only)
  require_env_file
  local pw
  if [[ -n "${LUMIRSS_NEW_PASSWORD:-}" ]]; then
    # Runtime secret via environment; never persisted, never echoed.
    LUMIRSS_NEW_PASSWORD="${LUMIRSS_NEW_PASSWORD}" DC_D run --rm -T --no-deps \
      -e LUMIRSS_NEW_PASSWORD bff python scripts/set_password.py
  elif [[ ! -t 0 ]]; then
    # Piped stdin (non-interactive automation): read here, pipe onward —
    # the value never becomes an argument or an env-file line.
    pw="$(cat)"
    if [[ -z "$pw" ]]; then
      err "empty password on stdin — export LUMIRSS_NEW_PASSWORD or pipe a password."
      exit 1
    fi
    printf '%s' "$pw" | DC_D run --rm -T --no-deps bff python scripts/set_password.py
  elif [[ -t 0 ]]; then
    read -r -s -p "New LumiRSS browser password: " pw; echo
    [[ -n "$pw" ]] || { err "empty password — aborted."; exit 1; }
    printf '%s' "$pw" | DC_D run --rm -T --no-deps bff python scripts/set_password.py
  else
    err "no password source — pipe it on stdin or export LUMIRSS_NEW_PASSWORD"
    exit 1
  fi
  log "password hash installed in the BFF database (plaintext not stored anywhere)."
}

cmd_freshrss_init() { # make the internal FreshRSS usable by the BFF
  require_env_file    # FreshRSS is network-isolated by design, so its web
  local user pw       # installer cannot be reached; everything happens CLI-side.
  user="$(env_value FRESHRSS_USERNAME)"
  user="${user:-admin}"
  pw="$(env_value FRESHRSS_API_PASSWORD)"
  local pw_changed=0
  if [[ -z "$pw" ]]; then
    pw="$(openssl rand -hex 16 2>/dev/null || head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    [[ ${#pw} -ge 16 ]] || pw="${pw}0lumirss"
    sed -i "s|^FRESHRSS_API_PASSWORD=.*|FRESHRSS_API_PASSWORD=$pw|" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
    pw_changed=1
    log "generated FRESHRSS_API_PASSWORD in $ENV_FILE"
  fi

  local installed
  installed="$(docker_cmd exec lumirss-freshrss sh -c \
    'test -s /var/www/FreshRSS/data/config.php && echo yes || echo no' 2>/dev/null || echo unknown)"
  if [[ "$installed" != "yes" ]]; then
    log "installing FreshRSS (sqlite, default user '$user', greader API enabled)…"
    docker_cmd exec lumirss-freshrss php ./cli/do-install.php \
      --default-user "$user" \
      --environment production \
      --base-url "$(env_value FRESHRSS_BASE_URL || echo http://freshrss)" \
      --language en \
      --auth-type form \
      --api-enabled \
      --db-type sqlite >/dev/null
  fi

  # idempotent on already-installed instances: the greader API must be on,
  # and the BFF user must exist with a greader API password.
  docker_cmd exec lumirss-freshrss php ./cli/reconfigure.php --api-enabled >/dev/null 2>&1 || \
    warn "could not run FreshRSS reconfigure --api-enabled (installed via do-install is already enabled)"

  if ! docker_cmd exec lumirss-freshrss php ./cli/list-users.php 2>/dev/null | grep -qx "$user"; then
    log "creating FreshRSS user '$user'…"
    docker_cmd exec lumirss-freshrss php ./cli/create-user.php \
      --user "$user" \
      --password "$pw" \
      --api-password "$pw" \
      --no-default-feeds >/dev/null
  fi

  if [[ "$pw_changed" == 1 ]]; then
    log "recreating bff to pick up FRESHRSS_API_PASSWORD…"
    DC_D up -d bff
  fi
  log "FreshRSS ready: user '$user' (web + greader API share the password stored hashed in FreshRSS; only FRESHRSS_API_PASSWORD lives in $ENV_FILE)"
}

# ---------------------------------------------------------------------------
cmd_export_images() { # ./lumirss export-images [--out DIR]
  local out="."
  if [[ "${1:-}" == "--out" ]]; then
    out="${2:-}"
    [[ -n "$out" ]] || { err "usage: ./lumirss export-images [--out DIR]"; exit 1; }
  fi
  local tag="${IMAGE_TAG:-latest}"
  # D-01: names must match docker-compose.prod.yml (ghcr.io/paidethon/lumirss/…)
  # and images_pull_or_build below — the pre-registry-segment names
  # (ghcr.io/paidethon/lumirss-web) no longer exist and broke the offline
  # release chain with image-not-found.
  local web_img="ghcr.io/paidethon/lumirss/lumirss-web:$tag"
  local bff_img="ghcr.io/paidethon/lumirss/lumirss-bff:$tag"
  local tar_name="lumirss-images-$tag.tar"
  mkdir -p "$out"
  log "exporting $web_img + $bff_img → $out/$tar_name (offline bundle)"
  docker_cmd save -o "$out/$tar_name" "$web_img" "$bff_img" \
    || { err "docker save failed — are both images pulled on this host? ('LUMIRSS_IMAGE_TAG=$tag ./lumirss update')"; exit 1; }
  ( cd "$out" && sha256sum "$tar_name" > SHA256SUMS )
  local extra=""
  if [[ -f release-manifest.json ]]; then
    if [[ "$out" != "." ]]; then cp -f release-manifest.json "$out/"; fi
    ( cd "$out" && sha256sum release-manifest.json >> SHA256SUMS )
    extra=" (+ release-manifest.json)"
  fi
  log "export complete: $out/$tar_name + SHA256SUMS$extra"
  log "on the target host: './lumirss import-images $out', then './lumirss deploy'."
}

cmd_import_images() { # ./lumirss import-images <DIR>
  local dir="${1:-}"
  if [[ -z "$dir" || ! -d "$dir" ]]; then
    err "usage: ./lumirss import-images <DIR>  (output of './lumirss export-images')"
    exit 1
  fi
  local tar
  tar="$(find "$dir" -maxdepth 1 -name 'lumirss-images-*.tar' | sort | tail -1)"
  [[ -n "$tar" ]] || { err "no lumirss-images-*.tar found in $dir"; exit 1; }
  if [[ -f "$dir/SHA256SUMS" ]]; then
    log "verifying SHA256SUMS in $dir"
    ( cd "$dir" && sha256sum -c SHA256SUMS ) \
      || { err "checksum verification failed — refusing to load a corrupted bundle."; exit 1; }
  else
    warn "no SHA256SUMS in $dir — loading without integrity verification"
  fi
  log "loading images from $tar"
  docker_cmd load -i "$tar" || { err "docker load failed."; exit 1; }
  log "images loaded — './lumirss deploy' / './lumirss update' will use them even when ghcr.io is unreachable."
}

# ---------------------------------------------------------------------------
# Optional ON-DEMAND LibreTranslate (docker-compose.translate.yml): machine
# translation for the reader, self-hosted. Deliberately outside deploy/
# update so a 2 GB host only pays its ~300-400 MB RAM while it is actually
# used; `restart: "no"` keeps it from coming back after a reboot.
require_docker() {
  command -v docker >/dev/null || { err "docker is required (https://docs.docker.com/engine/install/ubuntu/)"; exit 1; }
}

translate_dc() { # base file + translate fragment only (NOT the mode overlays)
  LUMIRSS_TRANSLATE_PORT="${LUMIRSS_TRANSLATE_PORT:-$(env_value LUMIRSS_TRANSLATE_PORT)}" \
    docker_cmd compose -f docker-compose.prod.yml -f docker-compose.translate.yml "$@"
}

translate_probe() { # tiny en→zh probe: prints the OUTPUT LENGTH, never content
  local len
  len="$(curl -fsS --max-time 5 -H 'Content-Type: application/json' \
    -d '{"q":"hello","source":"en","target":"zh","format":"text"}' \
    "http://127.0.0.1:${LUMIRSS_TRANSLATE_PORT:-50050}/translate" 2>/dev/null \
    | python3 -c 'import json,sys
try:
    t = json.load(sys.stdin).get("translatedText")
    print(len(t) if isinstance(t, str) else "?")
except Exception:
    print("?")' 2>/dev/null || true)"
  if [[ -n "$len" && "$len" != "?" ]]; then
    log "probe: en→zh OK (translated output: $len chars; content not printed)."
  else
    warn "probe: en→zh failed — service starting, models still downloading, or translation unavailable."
  fi
}

cmd_translate_up() { # ./lumirss translate up
  require_docker
  translate_dc up -d libretranslate
  log "libretranslate starting — the FIRST start downloads the en/zh models (~200-400 MB) into the lumirss-libretranslate-models volume; check './lumirss translate status'."
}

cmd_translate_stop() { # ./lumirss translate stop
  require_docker
  translate_dc stop libretranslate
  log "libretranslate stopped (container + model volume kept; './lumirss translate up' reuses them)."
}

cmd_translate_status() { # ./lumirss translate status
  require_docker
  local state
  state="$(docker_cmd inspect \
    --format '{{.State.Status}} (health: {{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}})' \
    lumirss-libretranslate 2>/dev/null || true)"
  if [[ -z "$state" ]]; then
    err "libretranslate is not running — it is on-demand by design; './lumirss translate up' starts it."
    exit 1
  fi
  log "libretranslate container: $state"
  log "endpoint: 127.0.0.1:${LUMIRSS_TRANSLATE_PORT:-50050} (host loopback, verification only) — Lumi settings use http://lumirss-libretranslate:5000 (compose network)"
  # Translation here is local/free and the request is tiny, so the probe
  # runs by default; LUMIRSS_TRANSLATE_PROBE=0 skips it.
  if [[ "${LUMIRSS_TRANSLATE_PROBE:-1}" != "0" ]]; then
    translate_probe
  fi
}

# ---------------------------------------------------------------------------
main() {
  local cmd="${1:-}"; shift || true
  local a
  local extra=()
  for a in "$@"; do
    case "$a" in
      --external-caddy) EXTERNAL_MODE=1;;
      --low-memory) LOW_MEMORY=1;;
      --auth-mode=*) AUTH_MODE_ARG="${a#--auth-mode=}";;
      *) extra+=("$a");;
    esac
  done
  if [[ -n "$AUTH_MODE_ARG" ]] && [[ "$AUTH_MODE_ARG" != "basic" && "$AUTH_MODE_ARG" != "session" ]]; then
    err "invalid --auth-mode '$AUTH_MODE_ARG' (expected basic|session)"
    exit 1
  fi
  # Subsequent invocations reuse the persisted mode.
  if [[ "$(env_value LUMIRSS_EXTERNAL_CADDY)" == "1" ]]; then
    EXTERNAL_MODE=1
  fi
  # precedence: explicit env var > .env.prod > default
  UPSTREAM_PORT="${LUMIRSS_UPSTREAM_PORT:-$(env_value LUMIRSS_UPSTREAM_PORT)}"
  UPSTREAM_PORT="${UPSTREAM_PORT:-18080}"
  IMAGE_TAG="${LUMIRSS_IMAGE_TAG:-$(env_value LUMIRSS_IMAGE_TAG)}"
  IMAGE_TAG="${IMAGE_TAG:-latest}"
  export LUMIRSS_IMAGE_TAG="$IMAGE_TAG"
  if ((EXTERNAL_MODE == 1)); then
    COMPOSE_ARGS+=(-f docker-compose.external-caddy.yml)
  fi
  # Obsidian read-only vault mount (Gate 4): when a host vault directory
  # is configured, overlay the fixed read-only /vault mount. The BFF only
  # ever sees the container path LUMIRSS_OBSIDIAN_VAULT_DIR.
  if [[ -n "$(env_value LUMIRSS_OBSIDIAN_VAULT_HOST_DIR)" ]]; then
    COMPOSE_ARGS+=(-f docker-compose.obsidian.yml)
    export LUMIRSS_OBSIDIAN_VAULT_HOST_DIR="$(env_value LUMIRSS_OBSIDIAN_VAULT_HOST_DIR)"
  fi
  # `--build` is a dev-only flag: refuse it before any production path
  # (preflight/configure/pull) gets a chance to run.
  for a in ${extra[@]+"${extra[@]}"}; do
    if [[ "$a" == "--build" ]]; then refuse_build_flag; fi
  done
  case "$cmd" in
    deploy)
      local dextra=()
      for a in "${extra[@]}"; do [[ "$a" == "--dry-run" ]] && export DRY_RUN=1 || dextra+=("$a"); done
      cmd_deploy "${dextra[@]}";;
    update)   cmd_update "${extra[@]}";;
    status)   cmd_status;;
    logs)     cmd_logs "${extra[@]}";;
    backup)   cmd_backup;;
    restore)  cmd_restore "${extra[@]}";;
    doctor)   cmd_doctor;;
    rollback) cmd_rollback;;
    caddy-config) cmd_caddy_config;;
    freshrss-init) cmd_freshrss_init;;
    set-password) cmd_set_password;;
    export-images) cmd_export_images "${extra[@]}";;
    import-images) cmd_import_images "${extra[@]}";;
    translate)
      local tsub="${extra[0]:-}"
      case "$tsub" in
        up)     cmd_translate_up;;
        stop)   cmd_translate_stop;;
        status) cmd_translate_status;;
        *) err "usage: ./lumirss translate up|stop|status"; exit 1;;
      esac;;
    -h|--help|help|"") usage;;
    *) err "unknown command: $cmd"; usage; exit 1;;
  esac
}

main "$@"
