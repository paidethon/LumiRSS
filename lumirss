#!/usr/bin/env bash
# LumiRSS self-hosted lifecycle: deploy / update / status / logs / backup /
# restore / doctor / rollback / export-images / import-images.
#
# Quick start on a fresh Ubuntu 22.04/24.04 x86_64 server:
#   git clone https://github.com/paidethon/LumiRSS.git && cd LumiRSS
#   sudo ./lumirss deploy
#
# Requirements: bash, docker engine + compose plugin, git, curl.
# Root is required only when the docker daemon needs it (or sudo docker).
set -euo pipefail

cd "$(dirname "$0")"

ENV_FILE=".env.prod"
# CLI version (goes into every backup MANIFEST.txt; recovery verifies against it).
LUMIRSS_CLI_VERSION="$(cat VERSION 2>/dev/null || echo dev)"
BACKUP_DIR="${LUMIRSS_BACKUP_DIR:-./backups}"

# Deploy mode: 0 = full stack (this stack's Caddy owns 80/443),
# 1 = external host Caddy (web publishes 127.0.0.1:$UPSTREAM_PORT only).
# `deploy --external-caddy` sets it and persists LUMIRSS_EXTERNAL_CADDY=1
# in $ENV_FILE, so update/status/doctor/rollback reuse the same topology.
EXTERNAL_MODE=0
# Auth mode: "" = whatever $ENV_FILE says; `deploy --auth-mode=basic|session`
# persists LUMIRSS_AUTH_MODE there. session = BFF login + long-lived
# cookies (Caddy adds no Basic Auth in that mode).
AUTH_MODE_ARG=""
# `deploy --low-memory` writes the single-user resource preset into
# $ENV_FILE (container limits + RSSHub cache/heap caps for ~1.6 GB hosts).
LOW_MEMORY=0
COMPOSE_ARGS=(-f docker-compose.prod.yml)
UPSTREAM_PORT="18080"

DC_D() { # compose via docker_cmd; export the persisted .env.prod values that
         # compose interpolation consumes, so a service's `environment:` always
         # matches the file. ARCH-10: the web container no longer receives the
         # whole .env.prod (BFF secrets must not live in the web/Caddy env) —
         # it gets exactly the variables its entrypoint/Caddyfile render with,
         # exported here right before the compose call.
  local k v
  export LUMIRSS_UPSTREAM_PORT="$UPSTREAM_PORT"
  for k in DOMAIN LUMIRSS_AUTH_MODE LUMIRSS_AUTH_USER LUMIRSS_AUTH_HASH \
           LUMIRSS_EXTERNAL_CADDY LUMIRSS_INTERNAL_TOKEN; do
    v="$(env_value "$k")"
    export "$k=$v"
  done
  docker_cmd compose \
    "${COMPOSE_ARGS[@]}" "$@"
}

log()  { printf '\033[1;34m[lumirss]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[lumirss]\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31m[lumirss]\033[0m %s\n' "$*" >&2; }

# ---------------------------------------------------------------------------
# docker access: prefer the current user; fall back to sudo when needed.
docker_cmd() {
  if docker info >/dev/null 2>&1; then
    docker "$@"
  elif command -v sudo >/dev/null 2>&1 && sudo -n docker info >/dev/null 2>&1; then
    sudo -n docker "$@"
  else
    docker "$@"
  fi
}

# ---------------------------------------------------------------------------
usage() {
  cat <<'USAGE'
LumiRSS — self-hosted reader lifecycle

  sudo ./lumirss deploy [--dry-run]             first-time / re-run install
  sudo ./lumirss deploy --external-caddy        … behind an existing host
                                  Caddy / reverse proxy (loopback-only web)
  sudo ./lumirss deploy --auth-mode=session     persistent session login
                                  (BFF bcrypt + cookies; no more Basic-Auth
                                  prompts) — then './lumirss set-password'
  sudo ./lumirss deploy --low-memory            single-user resource preset
                                  (tighter container limits + RSSHub caps)
  ./lumirss update                              backup → pull → up → health
                                  (with LUMIRSS_DEPLOY_STATUS_FILE set, stage
                                  progress is written as JSON and shown
                                  read-only in the admin console)
  ./lumirss status                              containers, health, versions
  ./lumirss logs [service] [-f]                 stack or single-service logs
  ./lumirss backup                              consistent backup: SQLite
                                  online-backup snapshots (live-DB safe) +
                                  file-level tars + MANIFEST.txt
  ./lumirss restore <backup.tar.gz> [--yes]     stop → restore → start → health
  ./lumirss doctor                              PASS/WARN/FAIL diagnostics
  ./lumirss rollback [--yes]                     previous images + config,
                                  schema-gated (FIX-196: refuses/warns before
                                  switching over a forward-migrated DB) and
                                  pinned to the image IDs that actually ran
                                  (FIX-204), not just mutable tags
  ./lumirss export-images [--out DIR]           docker save the pinned images
                                  to a tar + SHA256SUMS (+ release manifest
                                  when present) for air-gapped hosts
  ./lumirss import-images <DIR>                 verify SHA256SUMS, then
                                  docker load an export made above
  ./lumirss caddy-config                        print the managed host-Caddy
                                  site block (BEGIN/END LUMIRSS markers)
  ./lumirss freshrss-init                       install/enable the internal
                                  FreshRSS + user for the BFF (idempotent)
  ./lumirss translate up|stop|status            optional ON-DEMAND self-hosted
                                  LibreTranslate (machine translation) — never
                                  part of deploy/update; first start downloads
                                  ~200-400 MB of en/zh models and the service
                                  wants ~300-400 MB RAM, so stop it again on
                                  a 2 GB host (see docs/how-to/
                                  optional-services.md)
  ./lumirss set-password                        install/rotate the browser
                                  login password (session auth mode); asks
                                  interactively or takes LUMIRSS_NEW_PASSWORD

Environment overrides: LUMIRSS_IMAGE_TAG, LUMIRSS_BACKUP_DIR,
LUMIRSS_DOMAIN, LUMIRSS_AUTH_USER, LUMIRSS_AUTH_HASH,
LUMIRSS_AUTH_PASSWORD, LUMIRSS_UPSTREAM_PORT (non-interactive deploys),
LUMIRSS_DEPLOY_STATUS_FILE (update-stage progress JSON for the admin
console; absolute path shared with the BFF container).

Production deploys are prebuilt-only: images always come from GHCR
(pinned by LUMIRSS_IMAGE_TAG); a pull failure aborts and leaves the
previously deployed stack running. Local builds are dev/CI only
(docker-compose.build.yml overlay); `deploy/update --build` is refused.
USAGE
}

require_env_file() {
  if [[ ! -f "$ENV_FILE" ]]; then
    err "$ENV_FILE not found — run './lumirss deploy' first."
    exit 1
  fi
}

env_value() { # env_value KEY [FILE]
  local file="${2:-$ENV_FILE}"
  [[ -f "$file" ]] || return 0
  grep -E "^$1=" "$file" | tail -1 | cut -d= -f2- || true
}

# Set (or append) KEY=VALUE in $ENV_FILE idempotently.
env_set() { # env_set KEY VALUE
  if grep -qE "^$1=" "$ENV_FILE"; then
    sed -i "s|^$1=.*|$1=$2|" "$ENV_FILE"
  else
    printf '%s=%s\n' "$1" "$2" >> "$ENV_FILE"
  fi
}

# Single-user resource preset for ~1.6 GB hosts sharing RAM with other
# containers. Values stay inside the benchmarked-safe ranges (web 64–96,
# bff 192–256, freshrss 256–320, rsshub 384–512 MB); RSSHub's V8 heap is
# capped below its container limit so native memory has headroom. Verify
# with './lumirss doctor' (no OOMKilled) and docker stats after applying,
# and tune per host — these are defaults, not laws.
apply_low_memory_preset() {
  log "applying low-memory preset to $ENV_FILE"
  env_set LUMIRSS_PROFILE "low-memory"
  env_set LUMIRSS_WEB_MEM_LIMIT "96m"
  env_set LUMIRSS_WEB_MEM_RESERVATION "48m"
  env_set LUMIRSS_BFF_MEM_LIMIT "256m"
  env_set LUMIRSS_BFF_MEM_RESERVATION "96m"
  env_set LUMIRSS_FRESHRSS_MEM_LIMIT "320m"
  env_set LUMIRSS_FRESHRSS_MEM_RESERVATION "96m"
  env_set LUMIRSS_RSSHUB_MEM_LIMIT "448m"
  env_set LUMIRSS_RSSHUB_MEM_RESERVATION "192m"
  env_set LUMIRSS_RSSHUB_MEMORY_MAX "64"
  env_set LUMIRSS_RSSHUB_NODE_OPTIONS "--max-old-space-size=256"
}

# Persist the requested auth mode (basic keeps the historical Caddy
# Basic Auth; session moves login into the BFF with long-lived cookies).
apply_auth_mode() { # apply_auth_mode basic|session
  env_set LUMIRSS_AUTH_MODE "$1"
  if [[ "$1" == "session" ]]; then
    # __Host- cookies + Secure need the public site to be HTTPS (it is,
    # behind the host Caddy); dev/HTTP-only operators may set 0 manually.
    env_set LUMIRSS_SESSION_SECURE_COOKIES "1"
  fi
}

# ---------------------------------------------------------------------------
hash_password() { # bcrypt for Caddy basic_auth; $ escaped for compose env.
  local plain="$1" h  # plaintext is piped via stdin, never an argv (ps-safe)
  if h="$(printf '%s' "$plain" | docker_cmd run --rm -i caddy:2-alpine caddy hash-password 2>/dev/null)"; then
    :
  elif docker_cmd image inspect freshrss/freshrss:1.29.1 >/dev/null 2>&1; then
    h="$(printf '%s' "$plain" | docker_cmd run --rm -i freshrss/freshrss:1.29.1 php -r 'echo password_hash(stream_get_contents(STDIN), PASSWORD_BCRYPT);' 2>/dev/null)"
  elif command -v python3 >/dev/null && python3 -c 'import bcrypt' 2>/dev/null; then
    h="$(printf '%s' "$plain" | python3 -c 'import bcrypt,sys; print(bcrypt.hashpw(sys.stdin.buffer.read(), bcrypt.gensalt()).decode())')"
  fi
  if [[ -n "${h:-}" ]]; then printf '%s' "$h" | sed 's/\$/\$\$/g'; fi
}

# ---------------------------------------------------------------------------
preflight() {
  command -v docker >/dev/null || { err "docker is required (https://docs.docker.com/engine/install/ubuntu/)"; exit 1; }
  docker_cmd compose version >/dev/null 2>&1 || { err "docker compose plugin is required"; exit 1; }
  command -v curl >/dev/null || { err "curl is required"; exit 1; }
  local arch
  arch="$(uname -m)"
  [[ "$arch" == "x86_64" ]] || warn "images are built for x86_64; this host is $arch"

  local domain
  domain="$(env_value DOMAIN)"
  if [[ -n "$domain" && "$domain" != "localhost" && "$domain" != "127.0.0.1" ]]; then
    if command -v getent >/dev/null && ! getent hosts "$domain" >/dev/null; then
      warn "DNS: '$domain' does not resolve yet — Let's Encrypt TLS will fail until it does."
    fi
    if ((EXTERNAL_MODE == 0)) && command -v ss >/dev/null; then
      for port in 80 443; do
        if ss -tln 2>/dev/null | grep -qE "[:.]$port\b"; then
          warn "port $port is already in use — stop the conflicting service or change the published ports."
        fi
      done
    fi
  fi
  if ((EXTERNAL_MODE == 1)) && command -v ss >/dev/null; then
    # The host proxy owns 80/443; this stack's only host footprint is the
    # loopback port. Occupied is fine when it is our own running web.
    if ss -lnt 2>/dev/null | awk '{print $4}' | grep -qE ":${UPSTREAM_PORT}$"; then
      if ! docker_cmd ps --format '{{.Names}} {{.Ports}}' 2>/dev/null \
          | grep -E "^lumirss-web .*127\.0\.0\.1:${UPSTREAM_PORT}->" >/dev/null; then
        err "loopback port $UPSTREAM_PORT is used by another service — set LUMIRSS_UPSTREAM_PORT in $ENV_FILE to a free high port."
        exit 1
      fi
    fi
  fi
  local avail
  avail="$(df -P . | awk 'NR==2{print $4}')"
  if [[ "$avail" -lt 2097152 ]]; then warn "less than 2 GiB free disk space"; fi
}

# ---------------------------------------------------------------------------
configure() { # interactive when values are missing; env vars win
  if [[ ! -f "$ENV_FILE" ]]; then
    cp .env.prod.example "$ENV_FILE"
    chmod 600 "$ENV_FILE"
  fi

  local domain user hash token
  domain="$(env_value DOMAIN)"; user="$(env_value LUMIRSS_AUTH_USER)"
  hash="$(env_value LUMIRSS_AUTH_HASH)"; token="$(env_value LUMIRSS_INTERNAL_TOKEN)"

  if [[ -n "${LUMIRSS_DOMAIN:-}" ]]; then domain="$LUMIRSS_DOMAIN"; fi
  if [[ -n "${LUMIRSS_AUTH_USER:-}" ]]; then user="$LUMIRSS_AUTH_USER"; fi
  if [[ -n "${LUMIRSS_AUTH_HASH:-}" ]]; then hash="$LUMIRSS_AUTH_HASH"; fi

  if [[ -z "$domain" && ! -t 0 ]]; then domain="localhost"; fi
  if [[ -z "$user" && ! -t 0 ]]; then user=""; fi
  if [[ -z "$hash" && ! -t 0 && -n "${LUMIRSS_AUTH_PASSWORD:-}" ]]; then
    hash="$(hash_password "$LUMIRSS_AUTH_PASSWORD")"
  fi
  if [[ -z "$token" ]]; then
    token="$(openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    sed -i "s|^LUMIRSS_INTERNAL_TOKEN=.*|LUMIRSS_INTERNAL_TOKEN=$token|" "$ENV_FILE"
  fi

  if [[ -t 0 ]]; then
    if [[ -z "$domain" ]]; then
      read -r -p "Domain (empty = localhost/HTTP only): " domain
      sed -i "s|^DOMAIN=.*|DOMAIN=$domain|" "$ENV_FILE"
    fi
    if [[ "$(env_value LUMIRSS_AUTH_MODE)" != "session" && -z "$user" ]]; then
      read -r -p "Admin username for browser login (empty = no auth): " user
      sed -i "s|^LUMIRSS_AUTH_USER=.*|LUMIRSS_AUTH_USER=$user|" "$ENV_FILE"
    fi
    if [[ "$(env_value LUMIRSS_AUTH_MODE)" != "session" && -z "$hash" && -n "$user" ]]; then
      log "Set the browser password (input hidden)."
      hash="$(docker_cmd run --rm caddy:2-alpine caddy hash-password 2>/dev/null | sed 's/\$/$$/g' || true)"
      if [[ -z "$hash" ]]; then
        read -r -s -p "Password (used to generate the bcrypt hash): " plain_pw; echo
        if [[ -n "$plain_pw" ]]; then hash="$(hash_password "$plain_pw")"; fi
      fi
      if [[ -n "$hash" ]]; then
        sed -i "s|^LUMIRSS_AUTH_HASH=.*|LUMIRSS_AUTH_HASH=$hash|" "$ENV_FILE"
      fi
    fi
  else
    sed -i "s|^DOMAIN=.*|DOMAIN=$domain|" "$ENV_FILE"
    sed -i "s|^LUMIRSS_AUTH_USER=.*|LUMIRSS_AUTH_USER=$user|" "$ENV_FILE"
    if [[ -n "$hash" ]]; then sed -i "s|^LUMIRSS_AUTH_HASH=.*|LUMIRSS_AUTH_HASH=$hash|" "$ENV_FILE"; fi
  fi
  if ((EXTERNAL_MODE == 1)); then
    # Idempotent: rewriting the same values keeps re-runs from regenerating
    # the token or moving the upstream port.
    sed -i "s|^LUMIRSS_EXTERNAL_CADDY=.*|LUMIRSS_EXTERNAL_CADDY=1|" "$ENV_FILE"
    sed -i "s|^LUMIRSS_UPSTREAM_PORT=.*|LUMIRSS_UPSTREAM_PORT=$UPSTREAM_PORT|" "$ENV_FILE"
  fi
  # Persist the deployed image tag so update/rollback reuse the exact same
  # immutable reference without needing the env var again (env still wins).
  # .env.prod files copied from older examples lack the key — append it.
  # FIX-184: the fallback is the release VERSION, never mutable latest.
  local tag_now="${LUMIRSS_IMAGE_TAG:-$(env_value LUMIRSS_IMAGE_TAG)}"
  tag_now="${tag_now:-$(cat VERSION 2>/dev/null || echo latest)}"
  if grep -qE '^LUMIRSS_IMAGE_TAG=' "$ENV_FILE"; then
    sed -i "s|^LUMIRSS_IMAGE_TAG=.*|LUMIRSS_IMAGE_TAG=$tag_now|" "$ENV_FILE"
  else
    printf 'LUMIRSS_IMAGE_TAG=%s\n' "$tag_now" >> "$ENV_FILE"
  fi
  local mode_note=""
  if ((EXTERNAL_MODE == 1)); then mode_note=", external-caddy"; fi
  log "config: $ENV_FILE (DOMAIN=$domain${user:+, auth user=$user}$mode_note)"
}

# ---------------------------------------------------------------------------
# Production is prebuilt-only: images come from GHCR pinned by
# LUMIRSS_IMAGE_TAG. Local builds exist solely for dev/CI via the
# docker-compose.build.yml overlay, so `--build` must never reach a
# production compose path (it would silently replace the pinned release
# with a build from whatever this checkout happens to be).
refuse_build_flag() {
  if [[ "${LUMIRSS_ENV:-}" == "production" ]] \
      || printf '%s\n' "${COMPOSE_ARGS[@]}" | grep -qx "docker-compose.prod.yml"; then
    err "--build is refused: production deploys are prebuilt-only (GHCR images pinned by LUMIRSS_IMAGE_TAG)."
    err "For a local dev/CI build use the overlay instead:"
    err "  LUMIRSS_BUILD_COMMIT=\"\$(git rev-parse HEAD)\" docker compose -f docker-compose.prod.yml -f docker-compose.build.yml build"
    exit 1
  fi
}

images_pull_or_build() { # $1 = "--build" (dev-only; refused on prod compose)
  if [[ "${1:-}" == "--build" ]]; then
    refuse_build_flag
  fi
  local tag="${IMAGE_TAG:-$(cat VERSION 2>/dev/null || echo latest)}"
  log "pulling prebuilt images (tag: $tag)"
  if DC_D pull 2>&1 | grep -qE " Pulled| up to date"; then
    return 0
  fi
  # Pull output varies across compose versions; when the images are already
  # present locally (e.g. pre-seeded via './lumirss import-images' on an
  # air-gapped host), use them — but never build: a failed pull must not
  # silently swap the pinned release for a local build. Names must stay in
  # sync with docker-compose.prod.yml / publish-images.yml (the registry
  # path gained the repository segment once already and this check missed
  # it).
  if docker_cmd image inspect "ghcr.io/paidethon/lumirss/lumirss-web:$tag" >/dev/null 2>&1 \
      && docker_cmd image inspect "ghcr.io/paidethon/lumirss/lumirss-bff:$tag" >/dev/null 2>&1; then
    warn "pull output not confirmed — using existing local images (tag: $tag)"
    return 0
  fi
  err "image pull failed and no local images exist for tag '$tag' — aborting."
  err "The previously deployed stack (if any) is still running and untouched."
  err "Check network/registry access to ghcr.io, or import an offline bundle: './lumirss import-images <DIR>'."
  # N196: return (not exit) so ./lumirss update can record the failed
  # pull stage + overall result in the deploy-status file first; callers
  # exit 1 themselves.
  return 1
}

wait_health() { # wait_health <timeout_seconds>
  local timeout="${1:-120}" waited=0
  log "waiting for health (max ${timeout}s)…"
  until DC_D exec bff python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=5).status==200 else 1)" >/dev/null 2>&1; do
    sleep 3; waited=$((waited + 3))
    if [[ $waited -ge $timeout ]]; then
      err "health check timed out after ${timeout}s"
      return 1
    fi
  done
  log "healthy."
}

# ---------------------------------------------------------------------------
# N196 升级进度上报：LUMIRSS_DEPLOY_STATUS_FILE 设置时，./lumirss update
# 把每个阶段（backup/pull/migrate/health）的运行/结果状态写入该路径的
# JSON（schema lumirss-deploy-status/v1），BFF GET /admin/deploy-status
# 把它只读转述给管理台进度页。写入是 best-effort：任何 I/O 失败只
# warn，绝不影响升级本身。文件内容绝无秘密——只有 run_id、阶段名、
# 状态、RFC3339(UTC) 时间戳与公开的镜像 tag。无效/缺失的旧文件会被整体
# 重写，不让坏状态卡住新的升级；跨 run 的旧进度同样整体作废（FIX-208）。
# FIX-208: 每次升级调用分配独立 run_id（UUID）——失败后的重试从零开始
# 记进度，绝不沿用上一次的 startedAt 或残留阶段状态（否则管理台进度页
# 会把两次升级混在一份 JSON 里，时间线完全失真）。deploy_status_write
# 在发现文件里的 runId 与本次不同（或旧文件没有 runId）时整体作废旧
# 内容重新开局。
deploy_status_begin() {
  [[ -n "${LUMIRSS_DEPLOY_STATUS_FILE:-}" ]] || return 0
  LUMIRSS_DEPLOY_RUN_ID="$(python3 -c 'import uuid; print(uuid.uuid4().hex)' 2>/dev/null || true)"
  LUMIRSS_DEPLOY_RUN_ID="${LUMIRSS_DEPLOY_RUN_ID:-run-$(date +%s)-$$}"
}

deploy_status_write() { # deploy_status_write STAGE STATUS [NOTE] ; result: deploy_status_write result STATUS
  [[ -n "${LUMIRSS_DEPLOY_STATUS_FILE:-}" ]] || return 0
  LUMIRSS_DEPLOY_STAGE="$1" LUMIRSS_DEPLOY_STATE="$2" LUMIRSS_DEPLOY_NOTE="${3:-}" \
  LUMIRSS_DEPLOY_PATH="$LUMIRSS_DEPLOY_STATUS_FILE" LUMIRSS_DEPLOY_TAG="${IMAGE_TAG:-}" \
  LUMIRSS_DEPLOY_RUN_ID="${LUMIRSS_DEPLOY_RUN_ID:-}" \
  python3 -c '
import datetime, json, os

path = os.environ["LUMIRSS_DEPLOY_PATH"]
now = datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
stage = os.environ["LUMIRSS_DEPLOY_STAGE"]
state = os.environ["LUMIRSS_DEPLOY_STATE"]
note = os.environ.get("LUMIRSS_DEPLOY_NOTE", "")
run_id = os.environ.get("LUMIRSS_DEPLOY_RUN_ID", "")
data = {}
if os.path.exists(path):
    try:
        with open(path, encoding="utf-8") as fh:
            loaded = json.load(fh)
        if isinstance(loaded, dict) and loaded.get("schema") == "lumirss-deploy-status/v1":
            data = loaded
    except (OSError, ValueError):
        data = {}
data.setdefault("schema", "lumirss-deploy-status/v1")
data.setdefault("command", "update")
data["imageTag"] = os.environ.get("LUMIRSS_DEPLOY_TAG", "") or None
data["updatedAt"] = now
if run_id and data.get("runId") != run_id:
    # FIX-208: 新的一次 run —— 上一次的 startedAt/阶段/result 全部作废。
    data = {
        "schema": "lumirss-deploy-status/v1",
        "command": "update",
        "runId": run_id,
        "startedAt": now,
        "imageTag": data.get("imageTag"),
        "stages": {},
    }
if "startedAt" not in data:
    data["startedAt"] = now
if run_id:
    data["runId"] = run_id
stages = data.setdefault("stages", {})
if stage == "result":
    for entry in stages.values():
        if isinstance(entry, dict) and entry.get("status") == "running":
            entry["status"] = "interrupted"
            entry["finishedAt"] = now
    data["result"] = {"status": state, "finishedAt": now}
else:
    entry = stages.get(stage)
    if not isinstance(entry, dict):
        entry = {}
    if state == "running" or "startedAt" not in entry:
        entry["startedAt"] = now
    entry["status"] = state
    entry["finishedAt"] = None if state == "running" else now
    if note:
        entry["note"] = note
    stages[stage] = entry
tmp = path + ".tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    json.dump(data, fh, ensure_ascii=False, indent=1, sort_keys=True)
    fh.write("\n")
os.replace(tmp, path)
' || warn "could not write deploy status (progress page will stay stale)"
}

snapshot_for_rollback() {
  mkdir -p "$BACKUP_DIR"
  cp -f "$ENV_FILE" "$BACKUP_DIR/.env.prod.previous"
  echo "${IMAGE_TAG:-$(cat VERSION 2>/dev/null || echo latest)}" > "$BACKUP_DIR/.image-tag.previous"
  # N197 回滚就绪检查：与 N196 deploy-status 同一挂载思路——设置
  # LUMIRSS_ROLLBACK_MANIFEST_FILE 时把前一镜像标签写成 JSON 清单，
  # 供 BFF GET /admin/rollback-readiness 只读透传（无秘密；写失败仅
  # 告警，绝不影响部署/回滚本身）。
  #
  # FIX-204: a mutable TAG is not what ran — a registry tag can be re-pushed,
  # so at rollback time it may resolve to a different image. The RUNNING
  # containers' image IDs are ground truth (the same probe verify_deployment
  # trusts), captured here BEFORE `up` replaces the containers. FIX-196: the
  # control-DB schema version at snapshot time is recorded next to them so
  # cmd_rollback can compare it against the CURRENT schema BEFORE switching
  # back. Every capture is best-effort: a failed probe records null and the
  # rollback gate degrades honestly — manifest writes never affect the
  # update/deploy itself.
  local id_bff id_web schema_versions
  id_bff="$(docker_cmd inspect --format '{{.Image}}' lumirss-bff 2>/dev/null || true)"
  id_web="$(docker_cmd inspect --format '{{.Image}}' lumirss-web 2>/dev/null || true)"
  printf '%s' "$id_bff" | grep -qE '^sha256:[0-9a-f]{6,64}$' || id_bff=""
  printf '%s' "$id_web" | grep -qE '^sha256:[0-9a-f]{6,64}$' || id_web=""
  schema_versions="$(control_schema_versions 2>/dev/null || true)"
  write_rollback_manifest "$BACKUP_DIR/.rollback-manifest.json"
  if [[ -n "${LUMIRSS_ROLLBACK_MANIFEST_FILE:-}" ]]; then
    write_rollback_manifest "$LUMIRSS_ROLLBACK_MANIFEST_FILE"
  fi
}

write_rollback_manifest() { # write_rollback_manifest DEST (values from caller scope)
  ROLLBACK_MANIFEST_PATH="$1" \
  ROLLBACK_MANIFEST_TAG="${IMAGE_TAG:-$(cat VERSION 2>/dev/null || echo latest)}" \
  ROLLBACK_MANIFEST_ID_BFF="${id_bff:-}" ROLLBACK_MANIFEST_ID_WEB="${id_web:-}" \
  ROLLBACK_MANIFEST_SCHEMA_VERSIONS="${schema_versions:-}" \
  ROLLBACK_MANIFEST_RUN_ID="${LUMIRSS_DEPLOY_RUN_ID:-}" \
  python3 - <<-'PY' || warn "could not write rollback manifest (rollback falls back to tags; readiness check reports absent)"
import datetime, json, os, tempfile

path = os.environ["ROLLBACK_MANIFEST_PATH"]
versions = [
    v for v in os.environ.get("ROLLBACK_MANIFEST_SCHEMA_VERSIONS", "").split(";")
    if v.strip().isdigit()
]
document = {
    "schema": "lumirss-rollback-manifest/v1",
    # Legacy field: the BFF readiness endpoint and operator scripts read it.
    "previousImageTag": os.environ["ROLLBACK_MANIFEST_TAG"],
    # FIX-204: image IDs of the containers RUNNING at snapshot time — the
    # pinned ground truth that survives mutable-tag drift. Null = unknown.
    "previousImageIdBff": os.environ.get("ROLLBACK_MANIFEST_ID_BFF") or None,
    "previousImageIdWeb": os.environ.get("ROLLBACK_MANIFEST_ID_WEB") or None,
    # FIX-196: control-DB schema version BEFORE this run switched images.
    "preUpdateSchemaVersion": int(versions[-1]) if versions else None,
    "runId": os.environ.get("ROLLBACK_MANIFEST_RUN_ID") or None,
    "writtenAt": datetime.datetime.now(datetime.timezone.utc).isoformat(
        timespec="seconds"
    ),
}
parent = os.path.dirname(path) or "."
os.makedirs(parent, exist_ok=True)
fd, tmp = tempfile.mkstemp(prefix=".rollback-manifest-", dir=parent)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(document, fh, ensure_ascii=False, indent=1, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, path)
finally:
    if os.path.exists(tmp):
        os.unlink(tmp)
PY
}

# FIX-196: the control DB's applied migration versions, ascending "1;2;3"
# (max = current schema version). The BFF container is asked first (the same
# channel doctor uses); when it cannot answer — stack down or crash-looping,
# the exact situations a rollback faces — the control DB is read straight off
# the lumi-data volume through a one-off READ-ONLY container (the same
# pattern as the FIX-192 snapshot pass). Both channels are read-only.
# Failing is honest: callers record "unknown" and the rollback gate refuses
# rather than guesses.
LUMI_SCHEMA_PROBE='
import os, sqlite3

db = sqlite3.connect(
    "file:" + os.environ["LUMI_SCHEMA_DB_PATH"] + "?mode=ro", uri=True, timeout=10.0
)
try:
    rows = db.execute(
        "SELECT version FROM schema_migrations ORDER BY version"
    ).fetchall()
finally:
    db.close()
print(";".join(str(r[0]) for r in rows))
'

control_schema_versions() { # prints "1;2;3" ascending; rc!=0 = unknowable
  local out
  if out="$(DC_D exec -e LUMI_SCHEMA_DB_PATH=/data/lumi.sqlite \
      bff python3 -c "$LUMI_SCHEMA_PROBE" 2>/dev/null)" \
      && [[ "$out" =~ ^[0-9]+(;[0-9]+)*$ ]]; then
    printf '%s\n' "$out"
    return 0
  fi
  local proj img
  proj="$(DC_D config --format json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("name",""))' 2>/dev/null || true)"
  img="$(backup_image)"
  if [[ -n "$proj" && -n "$img" ]] \
      && out="$(printf '%s' "$LUMI_SCHEMA_PROBE" | docker_cmd run --rm -i \
            -e LUMI_SCHEMA_DB_PATH=/src/lumi.sqlite \
            -v "${proj}_lumi-data:/src:ro" \
            --entrypoint python3 "$img" - 2>/dev/null)" \
      && [[ "$out" =~ ^[0-9]+(;[0-9]+)*$ ]]; then
    printf '%s\n' "$out"
    return 0
  fi
  return 1
}

# ---------------------------------------------------------------------------
# FIX-195 升级锁：同一台机器同时触发两次 ./lumirss update（双击/手动重试
# 撞上定时任务）绝不允许并发迁移或互相覆盖释放目录。用 flock(2) 独占锁：
# - 原子性由内核保证（不带 mkdir 锁的 TOCTOU 竞态）；
# - 崩溃/断电后 fd 随进程关闭、锁自动释放——不存在需要人工清理的"陈旧
#   锁文件"，下一次运行直接可取（文件里只是 pid 提示，不是锁本身）；
# - deploy 与 update 共用这把锁（二者都会重建容器、改写 .env.prod）。
UPDATE_LOCK_FILE=".update.lock"

acquire_update_lock() {
  if ! command -v flock >/dev/null 2>&1; then
    # Ubuntu 22.04/24.04 必带 util-linux；缺了就如实降级并提示，不静默。
    warn "flock not available — concurrent update/deploy runs cannot be prevented (install util-linux)."
    return 0
  fi
  exec 9>>"$UPDATE_LOCK_FILE" || { err "cannot open lock file $UPDATE_LOCK_FILE"; exit 1; }
  if ! flock -n 9; then
    local owner
    owner="$(cat "$UPDATE_LOCK_FILE" 2>/dev/null || echo '?')"
    err "another lumirss deploy/update is already running (holder pid: ${owner}; lock: $(pwd)/$UPDATE_LOCK_FILE)."
    err "Concurrent runs could interleave migrations or clobber the release directory — refusing this run."
    err "If no update is actually running, its lock was already released by the OS — simply retry."
    exit 1
  fi
  # 持有者记录仅用于上面的报错提示；写入失败不影响锁的效力。
  printf '%s\n' "$$" > "$UPDATE_LOCK_FILE" 2>/dev/null || true
}

cmd_deploy() {
  acquire_update_lock   # FIX-195: 与 update 互斥（重建容器/写 .env.prod 的两个入口）
  preflight
  if ((LOW_MEMORY == 1)); then apply_low_memory_preset; fi
  if [[ -n "$AUTH_MODE_ARG" ]]; then apply_auth_mode "$AUTH_MODE_ARG"; fi
  configure
  if [[ "${DRY_RUN:-0}" == "1" ]]; then
    log "dry-run: validated configuration and preflight only."
    DC_D config >/dev/null && log "compose config renders OK."
    if [[ "$(env_value LUMIRSS_AUTH_MODE)" == "session" ]]; then
      log "session auth enabled — after the real deploy, set the browser password: './lumirss set-password'"
    fi
    return 0
  fi
  snapshot_for_rollback
  images_pull_or_build "${1:-}" || exit 1
  DC_D up -d --remove-orphans
  if wait_health 180; then
    if ((EXTERNAL_MODE == 1)); then
      log "deploy complete (external host Caddy mode). Host Caddy site block — add to the host Caddyfile and reload:"
      cmd_caddy_config || true
    else
      log "deploy complete. Open: http://localhost/ (or https://$(env_value DOMAIN)/)"
    fi
    if [[ "$(env_value LUMIRSS_AUTH_MODE)" == "session" ]]; then
      if [[ -n "${LUMIRSS_AUTH_PASSWORD:-}" ]]; then
        # One-shot runtime secret: hash lands in the BFF DB, plaintext is
        # never written to disk/env-files/logs (consumed and dropped here).
        if LUMIRSS_NEW_PASSWORD="${LUMIRSS_AUTH_PASSWORD}" DC_D run --rm -T --no-deps \
            -e LUMIRSS_NEW_PASSWORD bff python scripts/set_password.py; then
          log "session password bootstrapped from LUMIRSS_AUTH_PASSWORD (hash only)."
          unset LUMIRSS_AUTH_PASSWORD
        else
          warn "password bootstrap failed — run './lumirss set-password' manually."
        fi
      else
        log "session auth enabled — set the browser password: './lumirss set-password'"
      fi
    fi
    cmd_freshrss_init || warn "FreshRSS init failed — run './lumirss freshrss-init' and check './lumirss logs freshrss'"
    ./lumirss status || true
  else
    err "deploy failed health check — run './lumirss logs bff' or './lumirss rollback'."
    exit 1
  fi
}

# ---------------------------------------------------------------------------
# FIX-199 部署完成判定：升级宣布"完成"前必须自证——
#   1) BFF /api/v1/version 经 compose 网络可达（与 './lumirss status' 同一
#      通道，带内部 token；只取 version/commit，不打印其它内容）；
#   2) 版本端点报告的 commit 与本次发布一致（可判定时：LUMIRSS_EXPECTED_
#      COMMIT 覆盖 > git rev-parse HEAD；无法判定则明说跳过，不算失败）；
#   3) lumirss-bff / lumirss-web 容器实际运行的镜像 ID 与本地按 tag 拉取的
#      镜像 ID 一致（防 tag 漂移/旧容器未被重建）。
# 任一硬性检查失败 → verify 阶段记 failed、result 记 failed 并以非零退出；
# 回滚保持手动（runbook 约定），本命令绝不自动回滚。
verify_deployment() { # verify_deployment TAG EXPECTED_COMMIT ; 0 = verified
  local tag="$1" expected_commit="$2" rc=0
  local token vout reported_commit svc img running_id pulled_id
  token="$(env_value LUMIRSS_INTERNAL_TOKEN)"
  vout="$(DC_D exec -e LT="$token" bff python -c "import urllib.request,json,os; req=urllib.request.Request('http://127.0.0.1:8000/api/v1/version', headers={'X-Lumi-Token': os.environ.get('LT','')}); print(urllib.request.urlopen(req, timeout=10).read().decode())" 2>/dev/null || true)"
  reported_commit="$(printf '%s' "$vout" | python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("commit") or "")
except Exception:
    print("")' 2>/dev/null || true)"
  if [[ -z "$vout" ]]; then
    err "verify: BFF /api/v1/version unreachable through the compose network — cannot prove what is running."
    rc=1
  fi
  if [[ -n "$expected_commit" && -n "$reported_commit" && "$reported_commit" != "$expected_commit" ]]; then
    err "verify: running BFF reports commit '$reported_commit' but this release is '$expected_commit' — version/commit mismatch."
    rc=1
  elif [[ -z "$expected_commit" || -z "$reported_commit" ]]; then
    warn "verify: commit comparison skipped (expected='${expected_commit:-(unknown)}', reported='${reported_commit:-(none)}') — the image-digest check remains the hard gate."
  fi
  for svc in bff web; do
    img="ghcr.io/paidethon/lumirss/lumirss-$svc:$tag"
    running_id="$(docker_cmd inspect --format '{{.Image}}' "lumirss-$svc" 2>/dev/null || echo "")"
    pulled_id="$(docker_cmd image inspect --format '{{.Id}}' "$img" 2>/dev/null || echo "")"
    if [[ -z "$running_id" || -z "$pulled_id" ]]; then
      err "verify: cannot compare the image of lumirss-$svc (running container: '${running_id:-(none)}', pulled '$img': '${pulled_id:-(none)}')."
      rc=1
    elif [[ "$running_id" != "$pulled_id" ]]; then
      err "verify: lumirss-$svc is NOT running the pinned image (running=$running_id, pulled=$pulled_id) — recreate did not take effect or the tag moved."
      rc=1
    fi
  done
  return "$rc"
}

cmd_update() {
  acquire_update_lock   # FIX-195: 第二个并发 run 在任何备份/拉取/迁移之前快速失败
  require_env_file
  preflight
  # N196: every stage is reported (running → ok/failed) into
  # $LUMIRSS_DEPLOY_STATUS_FILE when set; writes are best-effort and
  # never alter the upgrade flow itself.
  deploy_status_begin   # FIX-208: 本次调用 = 新 run（新 runId，旧进度作废）
  deploy_status_write backup running
  if cmd_backup; then
    deploy_status_write backup ok
  else
    # FIX-201: 备份失败绝不继续升级——没有可靠备份就没有新版本。
    # 先记录阶段结果再退出；旧服务原样保持运行，pull/切流/迁移都不会发生。
    deploy_status_write backup failed
    deploy_status_write result failed
    err "pre-update backup failed — update aborted BEFORE pull/switch/migration; the old services keep running (existing backups: $BACKUP_DIR)."
    exit 1
  fi
  snapshot_for_rollback
  deploy_status_write pull running
  if ! images_pull_or_build "${1:-}"; then
    deploy_status_write pull failed
    deploy_status_write result failed
    exit 1
  fi
  deploy_status_write pull ok
  deploy_status_write migrate running "containers recreated; the BFF applies SQLite migrations at startup"
  if ! DC_D up -d --remove-orphans; then
    deploy_status_write migrate failed
    deploy_status_write result failed
    err "container recreate failed — the previous stack may still be running; check './lumirss logs'."
    exit 1
  fi
  deploy_status_write migrate ok
  deploy_status_write health running
  if wait_health 180; then
    deploy_status_write health ok
    # FIX-199: 健康检查只证明新容器活了；完成判定还要版本端点与镜像
    # digest 都对得上本次发布。
    deploy_status_write verify running "version endpoint + image digests must match the pinned release"
    if verify_deployment "$IMAGE_TAG" \
        "${LUMIRSS_EXPECTED_COMMIT:-$(git rev-parse HEAD 2>/dev/null || true)}"; then
      deploy_status_write verify ok
      deploy_status_write result success
      log "update complete (verified: version endpoint + image digests match)."
      ./lumirss status || true
    else
      deploy_status_write verify failed "running stack does not match the pinned release"
      deploy_status_write result failed
      err "update finished but post-switch verification FAILED — the running stack does not match the intended release."
      err "Rollback is manual per runbook: './lumirss rollback'. Treat this deployment as unverified."
      exit 1
    fi
  else
    deploy_status_write health failed
    deploy_status_write result failed
    err "update failed health check — run './lumirss rollback'."
    exit 1
  fi
}

cmd_status() {
  require_env_file
  DC_D ps
  local port
  echo
  if DC_D ps --status running 2>/dev/null | grep -q lumirss-web; then
    local commit port suffix
    local token; token="$(env_value LUMIRSS_INTERNAL_TOKEN)"
    commit="$(DC_D exec -e LT="$token" bff python -c "import urllib.request,json,os; req=urllib.request.Request('http://127.0.0.1:8000/api/v1/version', headers={'X-Lumi-Token': os.environ.get('LT','')}); print(urllib.request.urlopen(req, timeout=5).read().decode())" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("commit") or "?")' 2>/dev/null || echo "?")"
    local meta
    meta="(domain: $(env_value DOMAIN) | bff commit: $commit | image tag: $(env_value LUMIRSS_IMAGE_TAG || echo latest))"
    if ((EXTERNAL_MODE == 1)); then
      log "web: https://$(env_value DOMAIN)/ via host Caddy → 127.0.0.1:${UPSTREAM_PORT} $meta"
    else
      port="${LUMIRSS_HTTP_PORT:-80}"
      if [[ "$port" != "80" ]]; then suffix=":$port"; else suffix=""; fi
      log "web: http://localhost${suffix}/ $meta"
    fi
  else
    warn "stack is not running — './lumirss deploy' to start."
  fi
}

