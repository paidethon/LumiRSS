# LumiRSS environment template
#
# Important:
# - No code reads these variables yet. They are placeholders for upcoming
#   implementation Issues.
# - Variable names may be adjusted by the configuration design of the
#   implementing Issue.
# - Never put real domains, usernames, passwords or API keys here.
# - "replace-me" style values are NOT runnable defaults.

# LumiRSS
LUMIRSS_ENV=
LUMIRSS_LOG_LEVEL=

# FreshRSS adapter
FRESHRSS_BASE_URL=
FRESHRSS_USERNAME=
FRESHRSS_API_PASSWORD=

# Runtime AI; optional and not implemented during repository bootstrap
RUNTIME_AI_PROVIDER=
RUNTIME_AI_BASE_URL=
RUNTIME_AI_API_KEY=
RUNTIME_AI_MODEL=
