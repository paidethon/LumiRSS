# npm run check:dashboard guards drift).
!tools/progress-dashboard/dist/
coverage/

# Editors and OS
.DS_Store
.idea/
.vscode/

# Task bundles / local archives
*.zip

# IDE agent session state (Qoder/Mimosa)
.mimosa/

