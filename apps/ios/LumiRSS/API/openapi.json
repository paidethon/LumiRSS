        "type": "null"
       }
      ],
      "title": "Contenthtml"
     },
     "kind": {
      "title": "Kind",
      "type": "string"
     },
     "label": {
      "title": "Label",
      "type": "string"
     },
     "lengthChars": {
      "default": 0,
      "title": "Lengthchars",
      "type": "integer"
     }
    },
    "required": [
     "kind",
     "label"
    ],
    "title": "ContentVariantOption",
    "type": "object"
   },
   "ContentVariantsBlock": {
    "description": "N032：正文明显变短时的版本选择块（未触发 → None）。\n\ntriggered 条件（服务端判定）：当前 contentHtml 长度 < 投影行记录的\n历史最大内容长度（content_max_len）的 40%。真实阈值事实，不猜测\n内容是否「完整」。",
    "properties": {
     "currentLength": {
      "title": "Currentlength",
      "type": "integer"
     },
     "maxLength": {
      "title": "Maxlength",
      "type": "integer"
     },
     "triggered": {
      "title": "Triggered",
      "type": "boolean"
     },
     "variants": {
