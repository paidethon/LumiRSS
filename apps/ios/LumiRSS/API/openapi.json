    "type": "object"
   },
   "AuthStatus": {
    "description": "Login / session-status payload; expiresAt is an ISO-8601 instant.\n\nmode tells the web app WHICH auth layer is active: \"basic\" = proxy\nBasic Auth (the app must not render its own login gate), \"session\" =\nBFF sessions (gate on ``authenticated``). userId/username/role carry\nthe server-verified identity for the account menu — the client never\ndeclares who it is. initialSources is only present on the invite\nactivation response (N001); every other surface omits it entirely.",
    "properties": {
     "authenticated": {
      "title": "Authenticated",
      "type": "boolean"
     },
     "expiresAt": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Expiresat"
     },
     "initialSources": {
      "anyOf": [
       {
        "items": {
         "$ref": "#/components/schemas/ActivationSourceResult"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Initialsources"
     },
     "mode": {
      "default": "session",
      "enum": [
       "basic",
       "session"
      ],
      "title": "Mode",
      "type": "string"
     },
     "newDevice": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "title": "Newdevice"
     },
     "role": {
      "anyOf": [
       {
        "enum": [
         "owner",
         "admin",
         "member"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Role"
     },
     "userId": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Userid"
     },
     "username": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Username"
     }
    },
    "required": [
     "authenticated"
    ],
    "title": "AuthStatus",
    "type": "object"
   },
   "Category": {
    "description": "One item of GET /api/v1/categories (includes empty categories).",
    "properties": {
