{
 "components": {
  "schemas": {
   "ActivationSourceResult": {
    "description": "One scheme initial-source subscription attempt (N001).\n\n``ok=False`` is an honest per-URL failure record — activation itself\nis never blocked or rolled back by a source failure.",
    "properties": {
     "error": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Error"
     },
     "ok": {
      "title": "Ok",
      "type": "boolean"
     },
     "url": {
      "title": "Url",
      "type": "string"
     }
    },
    "required": [
     "url",
     "ok"
    ],
    "title": "ActivationSourceResult",
    "type": "object"
   },
   "ApiVersionInfo": {
    "description": "GET /api/v1/version (build provenance for Web/BFF skew diagnosis).",
    "properties": {
