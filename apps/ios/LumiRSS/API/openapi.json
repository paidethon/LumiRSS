      "type": "string"
     },
     "pendingToken": {
      "maxLength": 256,
      "minLength": 16,
      "title": "Pendingtoken",
      "type": "string"
     }
    },
    "required": [
     "pendingToken",
     "code"
    ],
    "title": "TotpVerifyRequest",
    "type": "object"
   },
   "ValidationError": {
    "properties": {
     "ctx": {
      "title": "Context",
      "type": "object"
     },
     "input": {
      "title": "Input"
     },
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "title": "Location",
      "type": "array"
     },
     "msg": {
      "title": "Message",
      "type": "string"
     },
     "type": {
      "title": "Error Type",
      "type": "string"
     }
    },
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError",
    "type": "object"
   },
   "lumirss__routers__subscriptions__SubscriptionCreate": {
    "description": "POST /api/v1/subscriptions body.\n\nfeedUrl must be an absolute http(s) URL (validated before FreshRSS);\ncategoryId, when given, must exist (404 otherwise); title is optional\n(a blank title is treated as absent — the feed's own title is used).",
    "properties": {
     "categoryId": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Categoryid"
     },
     "feedUrl": {
      "minLength": 1,
      "title": "Feedurl",
      "type": "string"
     },
     "title": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Title"
     }
    },
    "required": [
     "feedUrl"
    ],
    "title": "SubscriptionCreate",
    "type": "object"
   }
  }
 },
 "info": {
  "title": "LumiRSS BFF",
  "version": "0.1.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/api/v1/auth/login": {
   "post": {
    "description": "Verify credentials, mint a per-user session.\n\nWrong-password and unknown-username share the generic failure shape\nand the same brute-force budget (no account oracle).\n\nN007: when the account has TOTP enabled, a correct password does NOT\nmint a session — the response is ``{totpRequired, pendingToken}`` and\nthe real session is issued by ``POST /auth/totp/verify`` (same\nbrute-force budget, one attempt per pending token).",
    "operationId": "login_api_v1_auth_login_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/LoginRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "anyOf": [
          {
           "$ref": "#/components/schemas/AuthStatus"
          },
          {
           "$ref": "#/components/schemas/LoginChallenge"
          }
         ],
         "title": "Response Login Api V1 Auth Login Post"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Login"
   }
  },
  "/api/v1/auth/logout": {
   "post": {
    "description": "Revoke the current session and expire the cookie.",
    "operationId": "logout_api_v1_auth_logout_post",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AuthStatus"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Logout"
   }
  },
  "/api/v1/auth/session": {
   "get": {
    "description": "Public probe: which auth layer is active, and is this browser\nholding a live session? Includes the server-verified identity (never\nfrom the request body) so the UI can render the account menu.",
    "operationId": "session_status_api_v1_auth_session_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AuthStatus"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Session Status"
   }
  },
  "/api/v1/auth/totp/verify": {
   "post": {
    "operationId": "totp_verify_api_v1_auth_totp_verify_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/TotpVerifyRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AuthStatus"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Totp Verify"
   }
  },
  "/api/v1/categories": {
   "get": {
    "description": "All categories including empty ones (tag/list folders).\n\nSame id/label contract as the category objects on /api/v1/feeds —\nthere is exactly one category model in Lumi.",
    "operationId": "categories_api_v1_categories_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/Category"
         },
         "title": "Response Categories Api V1 Categories Get",
         "type": "array"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Categories"
   }
  },
  "/api/v1/entries": {
   "get": {
    "description": "One filtered page of entries — list fields only, never bodies.\n\nFiltering happens upstream (FreshRSS). Cursor rules: without a cursor,\na missing view means \"all\"; with a cursor, a missing view/feedUrl/\nsourceType/categoryId adopts the cursor's scope, while an explicit\nview/feedUrl/sourceType/categoryId must match the cursor's scope\nexactly (else 400, before touching FreshRSS).\n\n0011 scope 扩展（§6/§13，全部服务端过滤，不用已加载页假筛选）：\n- sourceType：当前唯一合法值 \"rss\"（全部条目都是 RSS；契约上独立\n  于“全部”，未来新增来源后有真实过滤行为）；\n- categoryId：FreshRSS 分类（greader label stream，适配器含默认\n  分类本地化名 fallback）；\n- feedUrl 与 categoryId 互斥（两者同时出现 → 400）。\n\nN034：``sort=received`` —— 页内按投影接收/投影时间（fetched_at）\n降序重排（服务端执行，query param 真实生效）；上游 continuation\n分页语义不变（页边界仍由 FreshRSS 决定，诚实边界）。同时为页内\n条目附带 timeCredibility（投影摄取时分类的发布时间异常）。\n\nFIX-239 显式排序规则（timeline ordering contract）：默认时间线按\n**上游发表时间**排序（FreshRSS 域内事实，Lumi 不改写）；声明为远\n未来的条目因此可能停留在时间线顶部——这类条目由投影摄取时标记\n（timeCredibility=future，N034），且 ``sort=received`` 提供按接收\n时间排序的显式逃生通道（接收序与声明日期无关，未来日期不能霸占\n排序）。转换型来源（API Sources）在生成 Atom 时直接封顶远未来声\n明日期（api_sources._entry_timing），不让未来条目进入上游时间线。",
    "operationId": "entries_api_v1_entries_get",
    "parameters": [
     {
      "in": "query",
      "name": "view",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "enum": [
          "all",
          "unread",
          "starred"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "View"
      }
     },
     {
      "in": "query",
      "name": "feedUrl",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Feedurl"
      }
     },
     {
      "in": "query",
      "name": "sourceType",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Sourcetype"
      }
     },
     {
      "in": "query",
      "name": "categoryId",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Categoryid"
      }
     },
     {
      "in": "query",
      "name": "cursor",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Cursor"
      }
     },
     {
      "in": "query",
      "name": "includeHidden",
      "required": false,
      "schema": {
       "default": false,
       "title": "Includehidden",
       "type": "boolean"
      }
     },
     {
      "in": "query",
      "name": "sort",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "const": "received",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Sort"
      }
     },
     {
      "in": "query",
      "name": "attention",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "enum": [
          "must_read",
          "excl_low"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Attention"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/EntryListResponse"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Entries"
   }
  },
  "/api/v1/entries/{entry_ref}": {
   "get": {
    "description": "One entry as plain text. Invalid refs are rejected before FreshRSS;\nreading a detail never marks anything as read (read-only milestone).\n\nF048：来源覆盖 extract_policy='web' 时，经安全有界抓取层抓原文正文\n（article_extract + SSRF 校验，≤2MB，不执行 JS），结果缓存于\nentry_extract_cache；失败回退 RSS 正文并置 extractionFailed=true。",
    "operationId": "entry_detail_api_v1_entries__entry_ref__get",
    "parameters": [
     {
      "in": "path",
      "name": "entry_ref",
      "required": true,
      "schema": {
       "title": "Entry Ref",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "extractOnce",
      "required": false,
      "schema": {
       "default": false,
       "title": "Extractonce",
       "type": "boolean"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/EntryDetail"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Entry Detail"
   }
  },
  "/api/v1/entries/{entry_ref}/state": {
   "patch": {
    "description": "Set the read/starred state of one entry (set semantics, not toggle).\n\n204 means FreshRSS accepted the write; it does not re-confirm that the\nentry exists. Invalid refs and invalid bodies are rejected before any\nFreshRSS call. The accepted state is mirrored into the derived search\nprojection so its unread/starred filters stay fresh between syncs.",
    "operationId": "entry_state_api_v1_entries__entry_ref__state_patch",
    "parameters": [
     {
      "in": "path",
      "name": "entry_ref",
      "required": true,
      "schema": {
       "title": "Entry Ref",
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/EntryStateUpdate"
       }
      }
     },
     "required": true
    },
    "responses": {
     "204": {
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Entry State"
   }
  },
  "/api/v1/search": {
   "get": {
    "description": "Global search over the derived projection.\n\n``q`` is required (1-200 characters, at most 4 whitespace-split terms).\n``state`` accepts \"unread\" (default: all); ``favorite`` filters\nstarred entries; ``from``/``to`` are inclusive/exclusive ISO dates\n(YYYY-MM-DD). ``categoryId``/``feedUrl`` scope the search; the two\nare mutually exclusive. F29 advanced conditions (optional):\n``intitle`` (title-only, ≤2 terms), ``phrase`` (exact phrase),\n``exclude`` (excluded terms, ≤2) — bound into the cursor scope so\npagination never drifts across changed conditions. NEW-364:\n``author`` filters on the indexed author column (LIKE, bound into\nthe cursor scope like every other condition).\n\nEach leg paginates independently: ``cursor`` keys the RSS leg,\n``libraryCursor`` the library leg; both cursors are bound to the\nquery scope and rejected (400) on mismatch. A ``null`` cursor next\nto a non-null ``libraryCursor`` means the RSS leg is exhausted.",
    "operationId": "search_api_v1_search_get",
    "parameters": [
     {
      "in": "query",
      "name": "q",
      "required": true,
      "schema": {
       "title": "Q",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "cursor",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Cursor"
      }
     },
     {
      "in": "query",
      "name": "libraryCursor",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Librarycursor"
      }
     },
     {
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
       "default": 20,
       "title": "Limit",
       "type": "integer"
      }
     },
     {
      "in": "query",
      "name": "feedUrl",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Feedurl"
      }
     },
     {
      "in": "query",
      "name": "categoryId",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Categoryid"
      }
     },
     {
      "in": "query",
      "name": "state",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "State"
      }
     },
     {
      "in": "query",
      "name": "favorite",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ],
       "title": "Favorite"
      }
     },
     {
      "in": "query",
      "name": "from_",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "From "
      }
     },
     {
      "in": "query",
      "name": "to",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "To"
      }
     },
     {
      "in": "query",
      "name": "intitle",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Intitle"
      }
     },
     {
      "in": "query",
      "name": "phrase",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Phrase"
      }
     },
     {
      "in": "query",
      "name": "exclude",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Exclude"
      }
     },
     {
      "in": "query",
      "name": "hasSummary",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ],
       "title": "Hassummary"
      }
     },
     {
      "in": "query",
      "name": "author",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Author"
      }
     },
     {
      "in": "query",
      "name": "expandSynonyms",
      "required": false,
      "schema": {
       "default": true,
       "title": "Expandsynonyms",
       "type": "boolean"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SearchResponse"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Search"
   }
  },
  "/api/v1/subscriptions": {
   "get": {
    "description": "Management view of all subscriptions (0013).\n\nEach item carries the Lumi-owned opaque subscriptionRef (built from\nFreshRSS's feed/<N> stream id — clients never assemble ids themselves)\nplus title/feedUrl/category. The read path (GET /api/v1/feeds) stays\nuntouched and compatible.",
    "operationId": "subscriptions_api_v1_subscriptions_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/Subscription"
         },
         "title": "Response Subscriptions Api V1 Subscriptions Get",
         "type": "array"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Subscriptions"
   },
   "post": {
    "description": "Subscribe to a feed URL; returns the server-confirmed subscription.\n\n409 when already subscribed (checked before any write); 400 feed_rejected\nwhen FreshRSS cannot add the feed. The write is attempted exactly once\n(no retry on timeout — clients re-read and reconcile).\n\nN191：管理员策略包（user_quotas.maxSources）在此事前拦截——按当前\n用户投影 search_feeds 计数，第 N+1 个来源直接 429 quota_exceeded，\nFreshRSS 侧零请求；成员没有任何路径可以提升该上限（设置端点是\nadmin-only，且本路由执行不读任何客户端提供的上限）。",
    "operationId": "create_subscription_api_v1_subscriptions_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/lumirss__routers__subscriptions__SubscriptionCreate"
       }
      }
     },
     "required": true
    },
    "responses": {
     "201": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Subscription"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Create Subscription"
   }
  },
  "/api/v1/version": {
   "get": {
    "description": "Build provenance for Web/BFF skew diagnosis.\n\nDeliberately minimal: no env dump, no paths, no secrets — just the\nrunning BFF's version/commit so a stale deployment is diagnosable\nfrom the browser (see also the web build commit on the About page).",
    "operationId": "version_api_v1_version_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ApiVersionInfo"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Version"
   }
  },
  "/health/live": {
   "get": {
    "description": "Liveness: only proves this process is alive, never touches FreshRSS.",
    "operationId": "health_live_health_live_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HealthStatus"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Health Live"
   }
  }
 },
 "servers": []
}
