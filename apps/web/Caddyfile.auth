# Caddyfile — single-user Basic Auth. Selected by docker-entrypoint.sh when
# LUMIRSS_AUTH_USER + LUMIRSS_AUTH_HASH are both set. The __AUTH_USER__ /
# __AUTH_HASH__ placeholders are substituted at container start (never
# committed as real values).

__SITE_ADDR__ {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		X-XSS-Protection "0"
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-aYPnowo+pCHklZyinTQjBAXVsi+QpQ7CfuGVjPnioBo='; style-src 'self' 'unsafe-inline'; img-src * data: blob:; media-src * data: blob:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	handle /api/* {
		reverse_proxy bff:8000 {
__INTERNAL_TOKEN_DIRECTIVE__
		}
	}

	# Generated feeds (API sources, mail bridge). FreshRSS subscribes over
	# the docker network directly; this route lets a BROWSER verify the
	# feed through Caddy too (secret-in-URL still applies; site auth
	# protects it in this mode).
	handle /feeds/* {
		reverse_proxy bff:8000 {
__INTERNAL_TOKEN_DIRECTIVE__
		}
	}

	# Single-user access control. The hash must be a bcrypt hash generated
	# with `docker run --rm caddy:2-alpine caddy hash-password`.
	basic_auth {
		__AUTH_USER__ __AUTH_HASH__
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
