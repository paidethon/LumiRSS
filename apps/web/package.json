{
  "name": "lumirss-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle-size.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "settings:generate": "cd ../../services/bff && uv run python scripts/export_settings_meta.py",
    "settings:check": "pnpm settings:generate && git diff --exit-code -- src/api/generated/settings-meta.ts",
    "api:generate": "(cd ../../services/bff && uv run python scripts/export_openapi.py) && pnpm exec openapi-typescript src/api/generated/openapi.json -o src/api/generated/schema.ts",
    "api:check": "pnpm api:generate && git diff --exit-code -- src/api/generated"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@tanstack/react-query": "^5.102.6",
    "dompurify": "^3.4.14",
    "lucide-react": "^1.34.0",
    "opencc-js": "^1.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@mozilla/readability": "^0.6.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.79.0",
    "sanitize-html": "^2.17.7",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620"
}
