# LumiRSS production configuration example.
# Copy to .env.prod and fill in real values. NEVER commit .env.prod.
#
# IMPORTANT — dollar signs: docker compose interpolates $VAR inside
# .env.prod values. A literal $ (e.g. in bcrypt hashes like $2b$12$…)
# MUST be written as $$. Example:
#   hash from caddy: $2b$12$abcdef…
#   write it here as: $$2b$$12$$abcdef…

# ---- Single-user access control ----
# Two modes (set by './lumirss deploy --auth-mode=...' or by hand):
#
# basic (default): Caddy basic_auth from LUMIRSS_AUTH_USER/LUMIRSS_AUTH_HASH
#   below. Generate the hash with:
#     docker run --rm caddy:2-alpine caddy hash-password
#   Leave both empty to disable auth (trusted LAN / behind a reverse proxy
#   that already provides auth). The hash is bcrypt, not the plain password.
#   Remember to double every $ in the bcrypt hash ($$) — see the note above.
#
# session: login lives in the BFF — one password (bcrypt, hash stored ONLY
#   in the BFF database; set it with './lumirss set-password'), then a
#   long-lived Secure/HttpOnly/SameSite=Strict session cookie. Static
#   assets are public in this mode; every other /api route requires the
#   session. 'deploy --auth-mode=session' fills LUMIRSS_AUTH_MODE below.
LUMIRSS_AUTH_MODE=
LUMIRSS_AUTH_USER=
LUMIRSS_AUTH_HASH=

# ---- Session auth tuning (only used when LUMIRSS_AUTH_MODE=session) ----
# Absolute inactivity window in days (regular use slides it forward, so an
# actively-used device effectively never re-prompts).
LUMIRSS_SESSION_MAX_AGE_DAYS=
# 1 = __Host- prefixed Secure cookies (requires HTTPS — every production
# deployment). 0 only for plain-HTTP local testing.
LUMIRSS_SESSION_SECURE_COOKIES=
# Optional exact public origin (https://rss.example.com) for the CSRF
# Origin check behind header-rewriting proxies. Empty = compare against
# the forwarded Host header (correct for this stack's Caddy chain).
LUMIRSS_PUBLIC_ORIGIN=

# ---- Resource budgets (single-user hosts / small VPS) ----
# Per-container docker limits. Defaults match the historical fixed values;
# './lumirss deploy --low-memory' writes a tighter measured preset here
# (web 96m / bff 256m / freshrss 320m / rsshub 448m + RSSHub cache/heap
# caps). After changing, verify with './lumirss doctor' — never ship a
# limit that gets OOMKilled.
LUMIRSS_WEB_MEM_LIMIT=
LUMIRSS_WEB_MEM_RESERVATION=
LUMIRSS_BFF_MEM_LIMIT=
LUMIRSS_BFF_MEM_RESERVATION=
LUMIRSS_FRESHRSS_MEM_LIMIT=
LUMIRSS_FRESHRSS_MEM_RESERVATION=
LUMIRSS_RSSHUB_MEM_LIMIT=
LUMIRSS_RSSHUB_MEM_RESERVATION=
# RSSHub in-process memory cache (MB) and V8 old-space cap. The container
# limit must stay clearly above the V8 heap (native memory headroom).
LUMIRSS_RSSHUB_MEMORY_MAX=
LUMIRSS_RSSHUB_NODE_OPTIONS=

# ---- Public site address (Caddy) ----
# Set a real FQDN for automatic Let's Encrypt TLS (ports 80+443).
# Leave empty/localhost for a trusted-LAN HTTP-only run.
DOMAIN=localhost

# ---- FreshRSS (internal service name; never a public URL) ----
FRESHRSS_BASE_URL=http://freshrss:80
FRESHRSS_USERNAME=admin
FRESHRSS_API_PASSWORD=
# Optional browser-safe public URL of the FreshRSS web UI (advanced escape
# hatch). Leave empty to hide the link. Must NOT be a Docker-internal name.
FRESHRSS_PUBLIC_URL=

# ---- RSSHub (internal service name) ----
# RSSHUB_BASE_URL: reachable from the BFF (preview fetching).
# RSSHUB_FRESHRSS_BASE_URL: reachable from FreshRSS (feed fetching after
# subscribe). Same value here because both live on the same internal network.
RSSHUB_BASE_URL=http://rsshub:1200
RSSHUB_FRESHRSS_BASE_URL=http://rsshub:1200

# ---- AI (optional) ----
# Server-side secret only; never reaches the browser.
AI_API_KEY=

# ---- Deployment pinning ----
# Image tag deployed by './lumirss deploy' (immutable :<sha> from GHCR, or
# latest). deploy persists what it deployed here; update / rollback reuse
# it, an explicit LUMIRSS_IMAGE_TAG env var still wins.
LUMIRSS_IMAGE_TAG=

# ---- External host Caddy mode (optional) ----
# Set to 1 when a reverse proxy (e.g. a systemd Caddy) already owns public
# 80/443 on this host: LumiRSS then publishes only
# 127.0.0.1:<LUMIRSS_UPSTREAM_PORT> (plain HTTP) and the existing proxy
# terminates TLS. './lumirss deploy --external-caddy' sets this for you;
# './lumirss caddy-config' prints the matching site block.
LUMIRSS_EXTERNAL_CADDY=
# Loopback port the web container publishes in external-Caddy mode
# (127.0.0.1:<port> -> 80). Empty = 18080. Pick a free high port.
LUMIRSS_UPSTREAM_PORT=

# ---- BFF internal token (0021, optional but recommended) ----
# When set, the BFF rejects every /api/* request that does not carry the
# matching X-Lumi-Token header; Caddy injects that header when forwarding
# /api/* to the BFF, so the browser needs nothing. Direct in-network
# callers (anything that bypasses Caddy) are refused. Must be URL-safe
# (letters, digits, ._~+/=-); generate e.g. with:
#   openssl rand -base64 32
# Set it here (both containers read this file) or not at all — setting it
# only on the Caddy side has no effect, only on the BFF side would 401
# every API call.
LUMIRSS_INTERNAL_TOKEN=

# ---- Obsidian vault projection (optional, read-only) ----
# Mount a host-side Obsidian vault into the BFF read-only. The vault is
# the source of truth; Lumi keeps a rebuildable projection and never
# writes back. Set LUMIRSS_OBSIDIAN_VAULT_HOST_DIR to the vault path ON
# THE HOST — it becomes a read-only bind mount at the fixed container
# path below; the app never sees (or stores) host paths. Leaving
# LUMIRSS_OBSIDIAN_VAULT_HOST_DIR empty disables the feature entirely
# (no mount, no scanner). The scan interval is seconds between
# incremental re-index passes; 0 = only manual rescan.
#   LUMIRSS_OBSIDIAN_VAULT_HOST_DIR=/srv/obsidian/MyVault
LUMIRSS_OBSIDIAN_VAULT_HOST_DIR=
# Fixed container path of the mount (docker-compose.obsidian.yml sets
# it to /vault; leave empty here and let the overlay own it).
LUMIRSS_OBSIDIAN_VAULT_DIR=
# Seconds between incremental re-index passes; empty = 0 (manual rescan
# only). 300 is a sensible production cadence.
LUMIRSS_OBSIDIAN_SCAN_INTERVAL=

# ---- Lumi Atom base (phase2 recovery, P0-05a) ----
# Docker-internal address FreshRSS uses to reach the BFF's generated
# Atom feeds (/feeds/...). MUST be reachable FROM the freshrss
# container. Default when empty: http://bff:8000 (the prod compose
# service name). For a dev compose (BFF on the host), set the address
# the freshrss container can dial, e.g. http://host.docker.internal:8000.
LUMIRSS_ATOM_BASE_URL=
