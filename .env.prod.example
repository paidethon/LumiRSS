# LumiRSS production configuration example.
# Copy to .env.prod and fill in real values. NEVER commit .env.prod.
#
# IMPORTANT — dollar signs: docker compose interpolates $VAR inside
# .env.prod values. A literal $ (e.g. in bcrypt hashes like $2b$12$…)
# MUST be written as $$. Example:
#   hash from caddy: $2b$12$abcdef…
#   write it here as: $$2b$$12$$abcdef…

# ---- Single-user access control (Caddy basic_auth) ----
# Generate the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password
# Leave both empty to disable auth (trusted LAN / behind a reverse proxy
# that already provides auth). The hash is bcrypt, not the plain password.
# Remember to double every $ in the bcrypt hash ($$) — see the note above.
LUMIRSS_AUTH_USER=
LUMIRSS_AUTH_HASH=

# ---- Public site address (Caddy) ----
# Set a real FQDN for automatic Let's Encrypt TLS (ports 80+443).
# Leave empty/localhost for a trusted-LAN HTTP-only run.
DOMAIN=localhost

# ---- FreshRSS (internal service name; never a public URL) ----
FRESHRSS_BASE_URL=http://freshrss:80
FRESHRSS_USERNAME=admin
FRESHRSS_API_PASSWORD=
# Optional browser-safe public URL of the FreshRSS web UI (advanced escape
# hatch). Leave empty to hide the link. Must NOT be a Docker-internal name.
FRESHRSS_PUBLIC_URL=

# ---- RSSHub (internal service name) ----
# RSSHUB_BASE_URL: reachable from the BFF (preview fetching).
# RSSHUB_FRESHRSS_BASE_URL: reachable from FreshRSS (feed fetching after
# subscribe). Same value here because both live on the same internal network.
RSSHUB_BASE_URL=http://rsshub:1200
RSSHUB_FRESHRSS_BASE_URL=http://rsshub:1200

# ---- AI (optional) ----
# Server-side secret only; never reaches the browser.
AI_API_KEY=

# ---- Deployment pinning ----
# Image tag deployed by './lumirss deploy' (immutable :<sha> from GHCR, or
# latest). deploy persists what it deployed here; update / rollback reuse
# it, an explicit LUMIRSS_IMAGE_TAG env var still wins.
LUMIRSS_IMAGE_TAG=

# ---- External host Caddy mode (optional) ----
# Set to 1 when a reverse proxy (e.g. a systemd Caddy) already owns public
# 80/443 on this host: LumiRSS then publishes only
# 127.0.0.1:<LUMIRSS_UPSTREAM_PORT> (plain HTTP) and the existing proxy
# terminates TLS. './lumirss deploy --external-caddy' sets this for you;
# './lumirss caddy-config' prints the matching site block.
LUMIRSS_EXTERNAL_CADDY=
# Loopback port the web container publishes in external-Caddy mode
# (127.0.0.1:<port> -> 80). Empty = 18080. Pick a free high port.
LUMIRSS_UPSTREAM_PORT=

# ---- BFF internal token (0021, optional but recommended) ----
# When set, the BFF rejects every /api/* request that does not carry the
# matching X-Lumi-Token header; Caddy injects that header when forwarding
# /api/* to the BFF, so the browser needs nothing. Direct in-network
# callers (anything that bypasses Caddy) are refused. Must be URL-safe
# (letters, digits, ._~+/=-); generate e.g. with:
#   openssl rand -base64 32
# Set it here (both containers read this file) or not at all — setting it
# only on the Caddy side has no effect, only on the BFF side would 401
# every API call.
LUMIRSS_INTERNAL_TOKEN=
