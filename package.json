{
  "name": "lumirss-docs",
  "private": true,
  "type": "module",
  "description": "Documentation site tooling only — the Web app lives in apps/web (pnpm), the BFF in services/bff (uv).",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint:commits": "commitlint --from ${BASE_SHA:-origin/main~20} --to HEAD",
    "check:version": "python3 scripts/check-version.py"
  },
  "devDependencies": {
    "vitepress": "^1.6.4",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
